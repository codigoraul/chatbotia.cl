---
import '../styles/global.css';
import DemoChatWidget from '../components/DemoChatWidget.astro';

const WHATSAPP = "https://api.whatsapp.com/send?phone=56961765268&text=Hola,%20los%20contacto%20por%20consulta%20de%20Chatbot%20con%20IA%2C%20me%20gustar%C3%ADa%20cotizar%3A";
const PHONE = "+56961765268";
const PHONE_DISPLAY = "+56 9 6176 5268";
const EMAIL = "codigoraul@gmail.com";

const faqs = [
  {
    q: "¿Cómo funciona un chatbot con IA en mi sitio web?",
    a: "Instalamos un widget de chat con inteligencia artificial en tu sitio web, entrenado con la información real de tu empresa (productos, precios, horarios, preguntas frecuentes). Responde automáticamente a tus visitantes las 24 horas y captura sus datos de contacto para que les hagas seguimiento.",
  },
  {
    q: "¿Cuánto cuesta un chatbot con IA para mi sitio web?",
    a: "Tenemos dos planes fijos, sin costos ocultos: $10.000 CLP mensuales para pymes y emprendimientos, y $15.000 CLP mensuales para empresas. El pago es por transferencia bancaria.",
  },
  {
    q: "¿Más adelante puedo sumar WhatsApp?",
    a: "Por ahora el servicio está enfocado 100% en tu sitio web. Si más adelante quieres sumar atención por WhatsApp Business, lo evaluamos como una ampliación aparte.",
  },
  {
    q: "¿Necesito saber programar para usar el chatbot?",
    a: "No. Nosotros configuramos el chatbot completo, entrenamos la IA con la información de tu negocio y te dejamos un panel simple para revisar conversaciones y actualizar respuestas cuando lo necesites.",
  },
];
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Chatbot con Inteligencia Artificial para tu sitio web en Chile: responde a tus visitantes 24/7, resuelve preguntas frecuentes y capta nuevos clientes de forma automática. Cotización gratis." />
  <meta name="keywords" content="chatbot con ia chile, chatbot inteligencia artificial, chatbot ia sitio web, chat ia para pagina web, asistente virtual con ia, chatbot ia pymes chile" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Chatbot con IA en Chile para tu Sitio Web | Atención al Cliente Automática 24/7" />
  <meta property="og:description" content="Chatbot con Inteligencia Artificial para tu sitio web en Chile: responde a tus visitantes 24/7, resuelve preguntas frecuentes y capta nuevos clientes de forma automática." />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:site_name" content="DiseñoPaginas.cl" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
  <title>Chatbot con IA en Chile para tu Sitio Web | Atención al Cliente Automática 24/7</title>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  })} />
</head>
<body>
  <!-- Topbar -->
  <div class="topbar">
    <div class="container">
      <div class="topbar-info">
        <span><i class="ti ti-mail-filled"></i> {EMAIL}</span>
        <span><i class="ti ti-map-pin-filled"></i> Temuco, Chile</span>
        <span><i class="ti ti-phone"></i> {PHONE_DISPLAY}</span>
      </div>
      <div class="topbar-social">
        <a href="https://www.facebook.com/PaginasChile/" target="_blank" rel="noopener" aria-label="Facebook"><i class="ti ti-brand-facebook"></i></a>
        <a href="https://www.instagram.com/disenopaginas/" target="_blank" rel="noopener" aria-label="Instagram"><i class="ti ti-brand-instagram"></i></a>
        <a href="https://www.linkedin.com/in/raul-riquelme-69a16859/" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="ti ti-brand-linkedin"></i></a>
        <a href={WHATSAPP} target="_blank" rel="noopener" aria-label="WhatsApp"><i class="ti ti-brand-whatsapp"></i></a>
      </div>
    </div>
  </div>

  <!-- Header -->
  <header class="header-main">
    <div class="container">
      <a href="https://diseñopaginas.cl" class="brand">
        <img src="https://diseñopaginas.cl/assets/img/logo-disenopaginas.svg" alt="DiseñoPáginas.cl" width="216" height="73" loading="eager" />
      </a>
      <div class="header-cta">
        <a href={WHATSAPP} target="_blank" rel="noopener" class="header-phone"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
        <a href="#contacto" class="btn btn-primary">Cotización Gratis</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <span class="hero-badge"><i class="ti ti-message-chatbot"></i> Atención Automática 24/7</span>
        <h1>Chatbot con IA <span class="accent">para tu Sitio Web</span></h1>
        <p class="lead">
          Instalamos un chatbot con inteligencia artificial en tu sitio web que responde a tus
          visitantes las 24 horas del día, resuelve dudas frecuentes y capta nuevos clientes
          automáticamente, sin que tengas que estar pendiente del celular.
        </p>
        <div class="hero-buttons">
          <a href="#contacto" class="btn btn-aqua btn-lg">Cotización Gratuita</a>
          <a href="#planes" class="btn btn-outline btn-lg">Ver Planes</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Subnav -->
  <nav class="subnav">
    <div class="container">
      <ul>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#beneficios">Beneficios</a></li>
        <li><a href="#planes">Planes</a></li>
        <li><a href="#faq">Preguntas frecuentes</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </div>
  </nav>

  <!-- Como funciona -->
  <section id="como-funciona" class="section">
    <div class="container">
      <div class="text-center mb-3" style="max-width:680px;margin-inline:auto">
        <h2>Un asistente de IA que atiende por ti</h2>
        <p class="text-muted" style="font-size:1.1rem">Ideal para empresas que reciben muchas consultas repetitivas y no dan abasto respondiendo una a una</p>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <div class="icon-tile"><i class="ti ti-message-chatbot"></i></div>
          <h4>Chat con IA en tu Sitio Web</h4>
          <p class="text-muted">Widget de chat integrado en tu página web que responde a los visitantes en tiempo real.</p>
          <ul>
            <li><i class="ti ti-check"></i>Captura de datos de contacto</li>
            <li><i class="ti ti-check"></i>Disponible en móvil y escritorio</li>
            <li><i class="ti ti-check"></i>Diseño acorde a tu marca</li>
          </ul>
        </div>
        <div class="card">
          <div class="icon-tile"><i class="ti ti-brain"></i></div>
          <h4>IA Entrenada con tu Negocio</h4>
          <p class="text-muted">El chatbot conoce tus productos, servicios, precios y preguntas frecuentes reales.</p>
          <ul>
            <li><i class="ti ti-check"></i>Respuestas precisas y personalizadas</li>
            <li><i class="ti ti-check"></i>Actualizable cuando lo necesites</li>
            <li><i class="ti ti-check"></i>Tono acorde a tu empresa</li>
          </ul>
        </div>
        <div class="card">
          <div class="icon-tile"><i class="ti ti-users"></i></div>
          <h4>Captura Automática de Leads</h4>
          <p class="text-muted">Cada conversación es una oportunidad: el chatbot pide nombre, teléfono e interés del cliente.</p>
          <ul>
            <li><i class="ti ti-check"></i>Datos organizados para tu equipo</li>
            <li><i class="ti ti-check"></i>Notificación de nuevos contactos</li>
            <li><i class="ti ti-check"></i>Más ventas, menos consultas perdidas</li>
          </ul>
        </div>
        <div class="card">
          <div class="icon-tile"><i class="ti ti-clock"></i></div>
          <h4>Atención Fuera de Horario</h4>
          <p class="text-muted">Tus clientes escriben a cualquier hora: el chatbot responde aunque tu equipo no esté disponible.</p>
          <ul>
            <li><i class="ti ti-check"></i>Sin horarios de atención</li>
            <li><i class="ti ti-check"></i>Menos clientes perdidos por demora</li>
            <li><i class="ti ti-check"></i>Mejor experiencia de compra</li>
          </ul>
        </div>
        <div class="card">
          <div class="icon-tile"><i class="ti ti-settings"></i></div>
          <h4>Configuración e Integración</h4>
          <p class="text-muted">Nosotros nos encargamos de todo el montaje técnico, sin que tengas que programar nada.</p>
          <ul>
            <li><i class="ti ti-check"></i>Puesta en marcha guiada</li>
            <li><i class="ti ti-check"></i>Panel simple de administración</li>
            <li><i class="ti ti-check"></i>Soporte post-implementación</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section id="beneficios" class="section bg-light">
    <div class="container">
      <div class="feature-row">
        <div>
          <h2>¿Por qué automatizar tu atención al cliente?</h2>
          <div class="feature-item">
            <div class="feature-icon"><i class="ti ti-bolt"></i></div>
            <div>
              <h5>Respuestas Instantáneas</h5>
              <p class="text-muted mb-0">Tus clientes reciben respuesta al segundo, sin esperar a que alguien de tu equipo esté disponible.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-icon"><i class="ti ti-trending-up"></i></div>
            <div>
              <h5>Más Conversión de Ventas</h5>
              <p class="text-muted mb-0">Menos consultas sin responder significa menos clientes que se van a la competencia.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-icon"><i class="ti ti-coin"></i></div>
            <div>
              <h5>Ahorra Tiempo de tu Equipo</h5>
              <p class="text-muted mb-0">La IA resuelve las preguntas repetitivas, y tu equipo se enfoca solo en los casos que realmente lo necesitan.</p>
            </div>
          </div>
          <div class="feature-item" style="margin-bottom:0">
            <div class="feature-icon"><i class="ti ti-award"></i></div>
            <div>
              <h5>+13 Años Creando Soluciones Digitales</h5>
              <p class="text-muted mb-0">La misma experiencia que aplicamos en diseño web la usamos para implementar tu chatbot con IA.</p>
            </div>
          </div>
        </div>
        <div class="feature-panel">
          <img src="https://diseñopaginas.cl/assets/img/servicios/chatbot-robot-ia.webp" alt="Ícono de chatbot con inteligencia artificial" loading="lazy" />
          <div>
            <h3>Un canal de ventas que nunca duerme</h3>
            <p class="text-muted">
              Cada mensaje sin responder es una venta que se puede perder. Un <strong>chatbot con
              inteligencia artificial</strong> atiende a tus visitantes al instante, directamente en
              tu sitio web, mientras tú te enfocas en hacer crecer tu negocio.
            </p>
            <a href="#contacto" class="btn btn-outline-navy">Solicitar Cotización <i class="ti ti-arrow-up-right"></i></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Planes -->
  <section id="planes" class="section">
    <div class="container">
      <div class="text-center mb-3" style="max-width:680px;margin-inline:auto">
        <h2>Planes de Chatbot con IA</h2>
        <p class="text-muted" style="font-size:1.1rem">Cada empresa es distinta: cotizamos según los canales y el volumen de conversaciones que necesites</p>
      </div>
      <div class="grid grid-2" style="max-width:820px;margin-inline:auto">
        <div class="price-card">
          <div class="icon-big"><i class="ti ti-building-store"></i></div>
          <h4>Pymes y Emprendimientos</h4>
          <p class="price">$10.000<span> CLP/mes</span></p>
          <p class="text-muted">Chatbot con IA instalado en tu sitio web, entrenado con la información de tu negocio.</p>
          <a href="#contacto" class="btn btn-outline-navy btn-block">Cotizar Plan</a>
        </div>
        <div class="price-card featured">
          <div class="icon-big"><i class="ti ti-building-skyscraper"></i></div>
          <h4>Empresas</h4>
          <p class="price">$15.000<span> CLP/mes</span></p>
          <p class="text-muted">Mismo servicio, pensado para negocios con mayor volumen de consultas.</p>
          <a href="#contacto" class="btn btn-primary btn-block">Cotizar Plan</a>
        </div>
      </div>
      <p class="text-center text-muted mb-0" style="margin-top:28px">Pago mensual por transferencia bancaria. Sin costos ocultos ni permanencia forzosa.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section bg-light">
    <div class="container">
      <h2 class="text-center mb-3">Preguntas frecuentes</h2>
      <div class="faq">
        {faqs.map((f, i) => (
          <div class={`faq-item${i === 0 ? " open" : ""}`}>
            <button class="faq-q" type="button">
              {f.q}
              <i class="ti ti-chevron-down chev"></i>
            </button>
            <div class="faq-a"><div class="faq-a-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="section">
    <div class="container">
      <div class="contact-panel">
        <div class="text-center mb-3">
          <h3>Cotiza tu Chatbot con IA</h3>
          <p class="text-muted mb-0">Cuéntanos sobre tu empresa y te enviamos una propuesta sin compromiso</p>
        </div>
        <form class="form-grid" action={`https://wa.me/56961765268`} method="GET" id="contactForm">
          <input type="text" name="nombre" placeholder="Nombre" required />
          <input type="tel" name="fono" placeholder="Teléfono" required />
          <input type="email" name="email" placeholder="Email" required />
          <select name="presupuesto" required>
            <option value="">¿Qué necesitas?</option>
            <option value="Plan Pyme - $10.000 CLP/mes">Plan Pyme ($10.000 CLP/mes)</option>
            <option value="Plan Empresa - $15.000 CLP/mes">Plan Empresa ($15.000 CLP/mes)</option>
            <option value="No estoy seguro, quiero asesoria">No estoy seguro, quiero asesoría</option>
          </select>
          <textarea class="full" name="mensaje" placeholder="Mensaje" rows="5" required></textarea>
          <button type="submit" class="btn btn-primary btn-block full">Enviar Mensaje</button>
        </form>
        <p class="form-note">Al enviar, se abrirá WhatsApp con tu mensaje listo para enviarnos. También puedes escribirnos a {EMAIL}.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container">
      <h2>¿Listo para automatizar tu atención al cliente?</h2>
      <p class="lead">Cotización gratuita y sin compromiso. Te asesoramos sobre el mejor plan para tu empresa.</p>
      <div class="cta-buttons">
        <a href="#contacto" class="btn btn-aqua btn-lg"><i class="ti ti-mail"></i> Cotización Gratuita</a>
        <a href={`tel:${PHONE}`} class="btn btn-outline btn-lg"><i class="ti ti-phone"></i> {PHONE_DISPLAY}</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div>
          <img src="https://diseñopaginas.cl/assets/img/logo-disenopaginas-n.png" alt="DiseñoPáginas.cl" width="216" height="73" loading="lazy" style="margin-bottom:18px" />
          <p style="max-width:420px">Somos especialistas en diseño web profesional con más de 13 años de experiencia creando sitios web de alta calidad. Creamos sitios modernos, responsivos y optimizados para SEO que impulsan el crecimiento de tu negocio.</p>
        </div>
        <div>
          <h5>Links relacionados</h5>
          <ul class="footer-links">
            <li><a href="https://diseñopaginas.cl/como-crear-tu-pagina-web/">Cómo crear tu página web</a></li>
            <li><a href="https://diseñopaginas.cl/diseno-web-pymes">Diseño Web Pymes</a></li>
            <li><a href="https://diseñopaginas.cl/servicios/diseno-logotipos">Logos y Afiche</a></li>
            <li><a href="https://diseñopaginas.cl/productos-online">Venta Online</a></li>
            <li><a href="https://diseñopaginas.cl/google-ads-chile/">Google Ads y Redes</a></li>
            <li><a href="https://aplicacionweb.cl" rel="dofollow" target="_blank">Apps web para tu negocio</a></li>
            <li><a href="https://diseñopaginas.cl/diseno-web-abogados">Abogados</a></li>
            <li><a href="https://diseñopaginas.cl/veterinarias">Veterinaria</a></li>
          </ul>
        </div>
        <div>
          <h5>Información de contacto</h5>
          <div class="footer-contact">
            <p><i class="ti ti-map-pin"></i> Temuco, Chile</p>
            <p><i class="ti ti-phone"></i> {PHONE_DISPLAY}</p>
            <p><i class="ti ti-mail"></i> {EMAIL}</p>
            <p><i class="ti ti-clock"></i> Lunes a sábado</p>
          </div>
          <h5 style="margin-top:24px">Síguenos</h5>
          <div class="footer-social">
            <a href="https://www.facebook.com/PaginasChile/" target="_blank" rel="noopener" aria-label="Facebook"><i class="ti ti-brand-facebook"></i></a>
            <a href="https://www.instagram.com/disenopaginas/" target="_blank" rel="noopener" aria-label="Instagram"><i class="ti ti-brand-instagram"></i></a>
            <a href="https://www.linkedin.com/in/raul-riquelme-69a16859/" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="ti ti-brand-linkedin"></i></a>
            <a href={WHATSAPP} target="_blank" rel="noopener" aria-label="WhatsApp"><i class="ti ti-brand-whatsapp"></i></a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="mb-0">Copyright &copy; {new Date().getFullYear()} <a href="https://diseñopaginas.cl">DiseñoPáginas.cl</a> — Todos los derechos reservados.</p>
        <p class="mb-0">Chatbot con IA en Chile</p>
      </div>
    </div>
  </footer>

  <DemoChatWidget />

  <script>
    // FAQ accordion
    document.querySelectorAll('.faq-item').forEach((item) => {
      const btn = item.querySelector('.faq-q');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach((el) => el.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
      });
    });

    // Contact form -> WhatsApp
    const form = document.getElementById('contactForm');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form as HTMLFormElement);
      const nombre = data.get('nombre');
      const fono = data.get('fono');
      const email = data.get('email');
      const presupuesto = data.get('presupuesto');
      const mensaje = data.get('mensaje');
      const text = `Hola, soy ${nombre} (tel: ${fono}, email: ${email}). Me interesa: ${presupuesto}. ${mensaje}`;
      window.open(`https://api.whatsapp.com/send?phone=56961765268&text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</body>
</html>
