---
import fs from 'node:fs';
import path from 'node:path';
import '../../styles/global.css';
import '../../styles/vertical.css';
import DemoChatWidget from '../../components/DemoChatWidget.astro';
import WebOffer from '../../components/WebOffer.astro';
import { landings, ciudades } from '../../data/landings';

const SITE = "https://chatbotia.cl";
const URL = `${SITE}/automotoras/`;
const WA_NUMBER = "56961765268";
const WHATSAPP = `https://api.whatsapp.com/send?phone=${WA_NUMBER}&text=${encodeURIComponent("Hola, los contacto desde chatbotia.cl/automotoras. Me interesa un chatbot con IA para mi automotora o rent a car.")}`;
const PHONE_DISPLAY = "+56 9 6176 5268";
const EMAIL = "codigoraul@gmail.com";
const FACEBOOK = "https://www.facebook.com/chatbotia.cl";
const DISENO_WEB = "https://diseñopaginas.cl";

const H1 = "Chatbot con IA para automotoras y rent a car";
const TITLE = "Chatbot con IA para Automotoras y Rent a Car | Chatia";
const DESCRIPTION = "Chat con IA para automotoras, rent a car y negocios de vehículos: responde consultas 24/7 en tu web y deja listos los datos de cada interesado. Desde $12.000 al mes en Chile.";
const OG_IMAGE = `${SITE}/assets/img/automotoras/og-chatbot-ia-automotoras.jpg`;
const IMG = "/assets/img/automotoras";

// Fotos opcionales: si el archivo existe en public/assets/img/automotoras/, se usa; si no, la sección se ve sin foto.
const has = (f: string) => fs.existsSync(path.join(process.cwd(), "public/assets/img/automotoras", f));
const PHOTOS = {
  hero: "automotoras-hero.webp",          // fondo del hero (con velo amarillo) y del cierre
  atencion: "automotoras-atencion.webp",  // junto a "¿Qué es...?"
  proceso: "automotoras-proceso.webp",    // fondo de "Cómo funciona"
  limites: "automotoras-limites.webp",    // sección "Informa, no cierra la venta"
  web: "automotoras-web.webp",            // sección diseño web
  contacto: "automotoras-contacto.webp",  // bajo los datos de contacto
};
const ok = Object.fromEntries(Object.entries(PHOTOS).map(([k, f]) => [k, has(f)]));

const rubros = [
  { icon: "ti-car", title: "Autos usados", text: "Modelos, años, kilometraje y rangos de precio.", q: "¿Tienen un SUV automático hasta $12 millones?" },
  { icon: "ti-steering-wheel", title: "Autos nuevos", text: "Versiones, equipamiento y cómo coordinar una prueba de manejo.", q: "¿Puedo probar el auto antes de comprar?" },
  { icon: "ti-credit-card", title: "Financiamiento", text: "Pie, crédito y contado: toma los datos para que un ejecutivo te contacte.", q: "¿Cuánto es el pie para financiar?" },
  { icon: "ti-arrows-exchange", title: "Retoma y parte de pago", text: "Recibe los datos del vehículo para cotizar la retoma.", q: "¿Reciben mi auto en parte de pago?" },
  { icon: "ti-key", title: "Rent a car", text: "Tipos de vehículo, tarifas por día, requisitos y retiro.", q: "¿Cuánto cuesta arrendar una camioneta por día?" },
  { icon: "ti-truck", title: "Camionetas y utilitarios", text: "Capacidad, uso comercial y disponibilidad referencial.", q: "¿Tienen camionetas para trabajo?" },
];

const faqs = [
  {
    q: "¿Qué es un chatbot con IA para una automotora o rent a car?",
    a: "Es un chat con inteligencia artificial que se instala en la página web de tu negocio y atiende al instante las consultas más repetidas: modelos, precios referenciales, requisitos, horarios y cómo ir a ver un vehículo o retirar uno. Se entrena con la información de tu negocio y deja los datos de cada interesado listos para que un vendedor lo contacte.",
  },
  {
    q: "¿El chatbot vende o aprueba créditos?",
    a: "No. El chatbot informa y recopila datos: nombre, teléfono, vehículo de interés, si tiene un auto para dejar en parte de pago y cómo piensa pagar. No promete aprobación de crédito, tasas ni cuotas; eso lo define tu equipo. Su trabajo es que ningún interesado se quede sin respuesta.",
  },
  {
    q: "¿Y si mi stock o mis precios cambian todas las semanas?",
    a: "Los vehículos y precios que informe el chatbot son los que tú le entregues: el plan Pymes incluye 1 actualización al mes y el plan Empresas, actualizaciones ilimitadas. Si tu stock cambia muy seguido, puedes cargarle modelos y rangos de precio, y que derive a un vendedor para confirmar disponibilidad. Hoy no se conecta automáticamente con sistemas de inventario.",
  },
  {
    q: "¿Sirve para un rent a car?",
    a: "Sí. Puede informar tipos de vehículo, tarifas por día, requisitos (por ejemplo licencia vigente y garantía), y horarios de retiro y devolución. No confirma reservas: toma nombre, teléfono, fechas y tipo de vehículo para que tu equipo confirme la disponibilidad.",
  },
  {
    q: "¿Puede agendar una visita o una prueba de manejo?",
    a: "No agenda en un calendario: toma el nombre, teléfono y el día u horario que prefiere el cliente, y te avisa por correo para que confirmes.",
  },
  {
    q: "¿Y si mi negocio no tiene página web o la mía está desactualizada?",
    a: "Te la podemos crear o rediseñar: DiseñoPáginas.cl diseña páginas web para automotoras y rent a car, con catálogo de vehículos, y el chatbot se instala en ella. La página se cotiza aparte; el chatbot funciona en cualquier sitio web que permita agregar un código.",
  },
  {
    q: "¿Funciona con WhatsApp, Facebook Marketplace o portales de avisos?",
    a: "Por ahora el chat se instala en tu página web. Si hoy vendes solo por portales o redes, una página propia con chatbot te permite atender a quienes te encuentran en Google a cualquier hora. La atención automática por WhatsApp Business la evaluamos como ampliación aparte.",
  },
  {
    q: "¿Cuánto cuesta un chatbot con IA para mi negocio?",
    a: "Tenemos dos planes fijos: $12.000 CLP mensuales para negocios pequeños (1.000 respuestas al mes, 1 chatbot) y $16.000 CLP mensuales para negocios con más volumen (2.000 respuestas al mes, hasta 2 chatbots, por ejemplo una sucursal más). La instalación es un pago único de $4.000 CLP. Pago mensual por transferencia, con boleta de honorarios y sin permanencia forzosa.",
  },
  {
    q: "¿Cuánto demora la instalación?",
    a: "Una vez que nos envías la información de tu negocio, el chatbot queda instalado y respondiendo en 24 horas.",
  },
  {
    q: "¿Qué pasa si el chatbot no sabe una respuesta?",
    a: "Está configurado para no inventar. Si no tiene la información, se lo dice al cliente y lo invita a dejar su nombre y contacto para que tu equipo le responda.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Chatbot con IA para automotoras y rent a car",
    "serviceType": "Chatbot con inteligencia artificial para páginas web de automotoras y negocios de vehículos",
    "provider": {
      "@type": "Organization",
      "name": "Chatia",
      "url": SITE,
      "logo": `${SITE}/assets/img/brand/chatia-icon-512.png`,
      "email": EMAIL,
      "telephone": "+56961765268",
      "sameAs": [FACEBOOK],
    },
    "areaServed": { "@type": "Country", "name": "Chile" },
    "offers": [
      { "@type": "Offer", "name": "Plan Pymes", "price": "12000", "priceCurrency": "CLP" },
      { "@type": "Offer", "name": "Plan Empresas", "price": "16000", "priceCurrency": "CLP" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Chatia", "item": `${SITE}/` },
      { "@type": "ListItem", "position": 2, "name": "Chatbot con IA para automotoras y rent a car", "item": URL },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  },
];
---

<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION} />
  <link rel="canonical" href={URL} />
  <meta name="theme-color" content="#F5C842" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={URL} />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:site_name" content="Chatia" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/dist/tabler-icons.min.css" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body class="vertical v-auto">
  <div class="topbar">
    <div class="container">
      <a href={WHATSAPP} target="_blank" rel="noopener"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
      <a href={`mailto:${EMAIL}`}><i class="ti ti-mail"></i> {EMAIL}</a>
      <span><i class="ti ti-map-pin"></i> Atendemos todo Chile</span>
      <a href={FACEBOOK} target="_blank" rel="noopener" class="topbar-social" aria-label="Chatbotia en Facebook"><i class="ti ti-brand-facebook"></i> Facebook</a>
    </div>
  </div>

  <header class="header-main">
    <div class="container">
      <a href="/" class="brand" aria-label="Chatia, inicio">
        <img src="/assets/img/brand/chatia-logo-h.webp" alt="Chatia – Chatbot con IA" width="565" height="120" loading="eager" />
      </a>
      <div class="header-cta">
        <a href={WHATSAPP} target="_blank" rel="noopener" class="header-phone"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
        <a href="#contacto" class="btn btn-yellow">Cotizar gratis</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class={`hero${ok.hero ? " hero-photo" : ""}`} style={ok.hero ? `--bg:url('${IMG}/${PHOTOS.hero}')` : undefined}>
    <div class="container hero-grid">
      <div>
        <span class="vtag"><i class="ti ti-car"></i> Para automotoras y rent a car</span>
        <h1>{H1}</h1>
        <p class="lead">
          Chat con IA para la página web de tu automotora o rent a car: responde consultas
          sobre vehículos, requisitos y horarios las 24 horas, y te deja los datos de cada
          interesado listos para que tu equipo cierre la venta o el arriendo.
        </p>
        <div class="hero-buttons">
          <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
          <a href="#planes" class="btn btn-white btn-lg">Ver planes</a>
        </div>
        <ul class="hero-facts">
          <li>Listo en 24 horas</li>
          <li>Desde $12.000 al mes</li>
          <li>Sin permanencia</li>
        </ul>
      </div>

      <div class="chat-preview" aria-label="Ejemplo de conversación con un chatbot con IA para una automotora">
        <div class="chat-preview-head">
          <img src="/assets/img/brand/chatia-avatar.webp" alt="" width="40" height="40" />
          <div>
            <strong>Asistente Automotora</strong>
            <span><span class="dot"></span> Responde al instante</span>
          </div>
        </div>
        <div class="chat-preview-body">
          <div class="cp-msg cp-user">Hola, ¿tienen alguna camioneta diésel del 2019 para trabajo?</div>
          <div class="cp-msg cp-bot">¡Hola! Sí, trabajamos camionetas diésel desde el 2018. Para ver qué unidad calza contigo, ¿me dejas tu nombre y teléfono, y cuánto piensas invertir?</div>
          <div class="cp-msg cp-user">Soy Diego, 9 1234 5678. Tengo un auto para dejar en parte de pago</div>
          <div class="cp-msg cp-bot">Gracias, Diego 😊 Le aviso a un vendedor para que te contacte hoy y vean también la retoma de tu auto.</div>
        </div>
        <p class="cp-note">Ejemplo con datos ficticios</p>
      </div>
    </div>
  </section>

  <nav class="subnav" aria-label="Secciones">
    <div class="container">
      <ul>
        <li><a href="#que-es">Qué es</a></li>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#vehiculos">Qué responde</a></li>
        <li><a href="#limites">Qué hace y qué no</a></li>
        <li><a href="#planes">Planes</a></li>
        <li><a href="#pagina-web">Página web</a></li>
        <li><a href="#faq">Preguntas frecuentes</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </div>
  </nav>

  <!-- Qué es -->
  <section id="que-es" class="band">
    <div class="container about-grid">
      <div>
        <h2>¿Qué es un chat con IA para automotoras?</h2>
        <p class="intro">
          Es un asistente con inteligencia artificial en la página web de tu negocio. Atiende a
          quienes buscan un vehículo o quieren arrendar uno, responde lo básico (modelos,
          precios referenciales, requisitos, horarios) y toma sus datos, incluso de noche o un
          domingo, cuando tus vendedores no están.
        </p>
        <ul class="feature-list">
          <li>
            <span class="ico"><i class="ti ti-bolt"></i></span>
            <div><strong>Responde al instante</strong><span>Con la información real de tu negocio: vehículos, rangos de precio, requisitos y horarios.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-moon"></i></span>
            <div><strong>Atiende 24/7</strong><span>Quien consulta por un auto a las 11 de la noche recibe respuesta, en vez de irse a otra automotora.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-user-plus"></i></span>
            <div><strong>Te entrega interesados</strong><span>Nombre, teléfono, vehículo de interés, retoma y forma de pago llegan a tu correo con la conversación completa.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-shield-check"></i></span>
            <div><strong>No inventa</strong><span>Si no sabe algo, invita al cliente a dejar sus datos para que tu equipo responda.</span></div>
          </li>
        </ul>
      </div>
      <div>
        {ok.atencion && (
          <figure class="photo"><img src={`${IMG}/${PHOTOS.atencion}`} alt="Vendedor atendiendo a un cliente en una automotora" width="1500" height="1000" loading="lazy" /></figure>
        )}
        <div class="quote-box">
          <h3>Quien pregunta por un auto de noche compra donde le responden primero</h3>
          <p>Quien busca vehículo consulta a varias automotoras a la vez y suele quedarse con la primera que contesta. Si tu equipo ya cerró o está atendiendo a otro cliente, esa consulta se enfría.</p>
          <p class="mb-0">Con un chatbot con IA, tu página responde en el momento y tus vendedores retoman el contacto cuando pueden.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section id="como-funciona" class={`band band-dark${ok.proceso ? " band-photo" : ""}`} style={ok.proceso ? `--bg:url('${IMG}/${PHOTOS.proceso}')` : undefined}>
    <div class="container">
      <div class="band-head">
        <h2>Cómo funciona</h2>
        <p>Tres pasos, sin que tengas que programar nada.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-num">1</span>
          <h3>Nos cuentas tu negocio</h3>
          <p>Modelos o tipos de vehículo, rangos de precio, requisitos, horarios y las preguntas que más te hacen.</p>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <h3>Entrenamos tu chatbot</h3>
          <p>La IA aprende solo de tu información y queda lista para atender como lo haría tu recepción.</p>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <h3>Queda instalado en tu web</h3>
          <p>En 24 horas atiende a tus visitantes y te avisa por correo cuando alguien deja sus datos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Qué responde -->
  <section id="vehiculos" class="band band-yellow">
    <div class="container">
      <div class="band-head">
        <h2>Un chatbot que conoce lo que venden y arriendan</h2>
        <p>Lo configuramos con tus vehículos, tus requisitos y las preguntas que más te hacen.</p>
      </div>
      <div class="rubros rubros-3">
        {rubros.map((r) => (
          <div class="rubro">
            <div class="bubble">{r.q}</div>
            <h3 class="rubro-name"><i class={`ti ${r.icon}`}></i> {r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Qué hace y qué no -->
  <section id="limites" class="band">
    <div class="container about-grid">
      <div>
        <h2>Informa y capta, no cierra la venta por ti</h2>
        <p class="intro">
          El chatbot es la primera atención de tu negocio: responde, recopila datos y deriva.
          La negociación, el crédito y la entrega siguen en manos de tu equipo.
        </p>
        <ul class="feature-list">
          <li>
            <span class="ico"><i class="ti ti-credit-card-off"></i></span>
            <div><strong>No promete créditos</strong><span>No asegura aprobaciones, tasas ni cuotas. Toma los datos y los deriva a tu ejecutivo.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-tag"></i></span>
            <div><strong>Tú controlas qué informa</strong><span>Solo usa los modelos, precios referenciales y requisitos que tú le entregas.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-refresh"></i></span>
            <div><strong>Stock y precios actualizables</strong><span>Nos envías los cambios y actualizamos al bot: 1 vez al mes en plan Pymes, ilimitado en plan Empresas.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-eye-off"></i></span>
            <div><strong>Conversaciones privadas</strong><span>Se guardan solo para el historial de tu negocio y no se venden ni se comparten con terceros.</span></div>
          </li>
        </ul>
      </div>
      <div>
        {ok.limites && (
          <figure class="photo"><img src={`${IMG}/${PHOTOS.limites}`} alt="Entrega de llaves de un vehículo a un cliente" width="1500" height="1000" loading="lazy" /></figure>
        )}
        <div class="quote-box">
          <h3>Pruébalo con una consulta real</h3>
          <p>Abre el chat de esta página y escríbele como lo haría un cliente: un auto usado, el pie para financiar, arrendar una camioneta. Puedes pedirle que actúe como asistente de una automotora o de un rent a car.</p>
          <p class="mb-0"><button type="button" class="btn btn-dark" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Planes -->
  <section id="planes" class="band band-soft">
    <div class="container">
      <div class="band-head">
        <h2>Planes y precios</h2>
        <p>Chatbot con IA para tu automotora o rent a car, con precios fijos y claros.</p>
      </div>
      <div class="plans">
        <div class="plan">
          <h3>Negocios pequeños</h3>
          <p class="price">$12.000 <span>CLP al mes</span></p>
          <ul>
            <li><i class="ti ti-check"></i> <span><strong>1.000 respuestas al mes</strong> (aprox. 250 conversaciones)</span></li>
            <li><i class="ti ti-check"></i> 1 chatbot instalado en tu página web</li>
            <li><i class="ti ti-check"></i> Entrenado con la información de tu negocio</li>
            <li><i class="ti ti-check"></i> Historial de conversaciones</li>
            <li><i class="ti ti-check"></i> Aviso por correo de cada contacto</li>
            <li><i class="ti ti-check"></i> Actualización de la información 1 vez al mes</li>
          </ul>
          <a href="#contacto" class="btn btn-white btn-block" data-plan="Plan Pymes - $12.000 CLP/mes">Cotizar plan Pymes</a>
        </div>
        <div class="plan featured">
          <span class="plan-tag">Ideal si cambias stock seguido</span>
          <h3>Negocios con más volumen</h3>
          <p class="price">$16.000 <span>CLP al mes</span></p>
          <ul>
            <li><i class="ti ti-check"></i> <span><strong>2.000 respuestas al mes</strong> (aprox. 500 conversaciones)</span></li>
            <li><i class="ti ti-check"></i> Hasta 2 chatbots (otro sitio o sucursal)</li>
            <li><i class="ti ti-check"></i> Entrenado con la información de tu negocio</li>
            <li><i class="ti ti-check"></i> Historial de conversaciones</li>
            <li><i class="ti ti-check"></i> Aviso por correo de cada contacto</li>
            <li><i class="ti ti-check"></i> Actualizaciones de información ilimitadas</li>
          </ul>
          <a href="#contacto" class="btn btn-dark btn-block" data-plan="Plan Empresas - $16.000 CLP/mes">Cotizar plan Empresas</a>
        </div>
      </div>
      <p class="plans-note">Instalación: pago único de $4.000 CLP. Mensualidad por transferencia bancaria, con boleta de honorarios. Sin permanencia forzosa.</p>
    </div>
  </section>

  <!-- Diseño o rediseño web (oferta secundaria) -->
  <WebOffer
    title="¿Tu negocio aún no tiene página web, o la actual quedó antigua?"
    intro="El chatbot necesita una página donde vivir. Si hoy vendes solo por portales de avisos o redes sociales, o tu página actual quedó desactualizada, DiseñoPáginas.cl puede crear la página web de tu automotora o rent a car, o rediseñar la que tienes, con catálogo de vehículos y un botón de contacto, y dejarla con el chatbot ya instalado."
    items={[
      { icon: "ti-world", title: "Te encuentran en Google", text: "Quien busca un auto o un arriendo en tu ciudad puede llegar a tu página, no solo a los portales de avisos." },
      { icon: "ti-layout-grid", title: "Catálogo de vehículos", text: "Fichas claras con fotos, precio y datos de cada vehículo, pensadas para celulares." },
      { icon: "ti-message-circle", title: "Con el chatbot incluido", text: "La página sale lista para atender consultas 24/7 desde el primer día." },
    ]}
    quoteTitle="Primero el chatbot, y la página si la necesitas"
    quoteParagraphs={[
      "Si ya tienes página web, instalamos el chatbot en ella y listo. Si no la tienes, o se ve antigua o no funciona bien en celulares, la creamos o la rediseñamos y la dejamos con el chatbot funcionando.",
      "La página web se cotiza aparte, según lo que necesite tu negocio.",
    ]}
    href={DISENO_WEB}
    image={ok.web ? { src: `${IMG}/${PHOTOS.web}`, alt: "Catálogo de vehículos en un sitio web de automotora" } : undefined}
  />

  <!-- FAQ -->
  <section id="faq" class="band band-soft">
    <div class="container">
      <div class="band-head">
        <h2>Preguntas frecuentes</h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <div class={`faq-item${i === 0 ? " open" : ""}`}>
            <button class="faq-q" type="button" aria-expanded={i === 0 ? "true" : "false"}>
              {f.q}
              <i class="ti ti-chevron-down chev"></i>
            </button>
            <div class="faq-a"><div class="faq-a-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="band">
    <div class="container contact-grid">
      <div>
        <h2>Cotiza tu chatbot con IA para tu automotora o rent a car</h2>
        <p class="intro" style="font-size:1.15rem;color:#4a4f56">Cuéntanos de tu negocio y te enviamos una propuesta sin compromiso.</p>
        <div class="contact-direct">
          <a href={WHATSAPP} target="_blank" rel="noopener"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
          <a href={`mailto:${EMAIL}`}><i class="ti ti-mail"></i> {EMAIL}</a>
          <a href={FACEBOOK} target="_blank" rel="noopener"><i class="ti ti-brand-facebook"></i> facebook.com/chatbotia.cl</a>
        </div>
        {ok.contacto && (
          <figure class="photo" style="margin-top:28px"><img src={`${IMG}/${PHOTOS.contacto}`} alt="Cliente recibiendo las llaves de su vehículo" width="1500" height="1000" loading="lazy" /></figure>
        )}
      </div>
      <div class="contact-form">
        <h3 class="contact-form-title">Formulario de contacto</h3>
        <form class="form-grid" id="contactForm">
          <input type="text" name="nombre" placeholder="Nombre" aria-label="Nombre" required />
          <input type="tel" name="fono" placeholder="Teléfono" aria-label="Teléfono" required />
          <input type="email" name="email" placeholder="Email" aria-label="Email" required />
          <select name="plan" id="planSelect" aria-label="Plan de interés" required>
            <option value="">¿Qué te interesa?</option>
            <option value="Plan Pymes - $12.000 CLP/mes">Chatbot: Plan Pymes ($12.000 al mes)</option>
            <option value="Plan Empresas - $16.000 CLP/mes">Chatbot: Plan Empresas ($16.000 al mes)</option>
            <option value="Chatbot + página web nueva o rediseño">Chatbot y página web (nueva o rediseño)</option>
            <option value="No estoy seguro, quiero asesoría">No estoy seguro, quiero asesoría</option>
          </select>
          <input class="full" type="text" name="web" placeholder="Página web de tu negocio (si tienes)" aria-label="Página web" />
          <textarea class="full" name="mensaje" placeholder="¿Vendes vehículos, arriendas o ambos?" aria-label="Mensaje" rows="4" required></textarea>
          <button type="submit" class="btn btn-dark btn-block full"><i class="ti ti-brand-whatsapp"></i> Enviar por WhatsApp</button>
        </form>
        <p class="form-note">Al enviar se abrirá WhatsApp con tu mensaje listo.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class={`band cta${ok.hero ? " band-photo-cta" : ""}`} style={ok.hero ? `--bg:url('${IMG}/${PHOTOS.hero}')` : undefined}>
    <div class="container cta-inner">
      <h2>Que ningún interesado se quede sin respuesta esta semana</h2>
      <div class="cta-buttons">
        <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
        <a href={WHATSAPP} target="_blank" rel="noopener" class="btn btn-white btn-lg"><i class="ti ti-brand-whatsapp"></i> Escríbenos</a>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div>
          <img class="footer-logo" src="/assets/img/brand/chatia-logo-h-white.webp" alt="Chatia" width="565" height="120" loading="lazy" />
          <p style="max-width:420px">Chatia instala chatbots con inteligencia artificial en páginas web de automotoras, rent a car, pymes y empresas de todo Chile, para que ningún cliente se quede sin respuesta.</p>
        </div>
        <div>
          <h3>Chatbot por rubro</h3>
          <ul class="footer-links">
            {landings.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
            <li><a href="/#rubros">Ver todos los rubros</a></li>
          </ul>
        </div>
        <div>
          <h3>Chatbot por ciudad</h3>
          <ul class="footer-links">
            {ciudades.map((c) => (
              <li><a href={c.href}>{c.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Contacto</h3>
          <div class="footer-contact">
            <p><i class="ti ti-brand-whatsapp"></i> <a href={WHATSAPP} target="_blank" rel="noopener">{PHONE_DISPLAY}</a></p>
            <p><i class="ti ti-mail"></i> <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
            <p><i class="ti ti-brand-facebook"></i> <a href={FACEBOOK} target="_blank" rel="noopener">Síguenos en Facebook</a></p>
            <p><i class="ti ti-map-pin"></i> Atendemos todo Chile</p>
            <p><i class="ti ti-clock"></i> Lunes a sábado</p>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="mb-0">&copy; {new Date().getFullYear()} Chatia, chatbot con IA en Chile</p>
        <p class="mb-0">Un servicio de <a href={DISENO_WEB} target="_blank" rel="noopener">DiseñoPáginas.cl</a></p>
        <p class="credits">Imágenes: <a href="https://www.freepik.com" target="_blank" rel="noopener">Freepik</a></p>
      </div>
    </div>
  </footer>

  <DemoChatWidget
    vertical="automotoras"
    botStatus="Asistente IA · Automotoras y rent a car"
    welcomeMessage="¡Hola! 👋 Soy Chatia, un chatbot con IA para automotoras y rent a car. Así atendería las consultas de tu negocio, 24/7. Pídeme que actúe como asistente de una automotora o de un rent a car, o pregúntame por el servicio."
    quickReplies={[
      { label: "Actúa como asistente de una automotora", reply: "" },
      { label: "Actúa como asistente de un rent a car", reply: "" },
      { label: "¿Y si mi stock cambia seguido?", reply: "" },
      { label: "¿Cuánto cuesta?", reply: "" },
    ]}
    disclaimer="Esta es una demo real con IA. Tu chatbot se entrena con la información de tu negocio."
  />

  <script>
    document.querySelectorAll('.faq-item').forEach((item) => {
      const btn = item.querySelector('.faq-q');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach((el) => {
          el.classList.remove('open');
          el.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.querySelectorAll('[data-open-chat]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const root = document.getElementById('demoChat');
        const bubble = document.getElementById('demoChatBubble');
        if (root && bubble && !root.classList.contains('is-open')) bubble.click();
      });
    });

    const planSelect = document.getElementById('planSelect') as HTMLSelectElement | null;
    document.querySelectorAll('[data-plan]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (planSelect) planSelect.value = (btn as HTMLElement).dataset.plan || '';
      });
    });

    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const web = String(data.get('web') || '').trim();
      const text =
        `Hola, los contacto desde chatbotia.cl/automotoras.\n` +
        `Nombre: ${data.get('nombre')}\nTeléfono: ${data.get('fono')}\nEmail: ${data.get('email')}\n` +
        `Me interesa: ${data.get('plan')}\n` +
        (web ? `Web: ${web}\n` : '') +
        `Negocio: ${data.get('mensaje')}`;
      window.open(`https://api.whatsapp.com/send?phone=56961765268&text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</body>
</html>
