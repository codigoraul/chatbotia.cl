---
import '../../styles/global.css';
import '../../styles/vertical.css';
import DemoChatWidget from '../../components/DemoChatWidget.astro';
import { landings, ciudades } from '../../data/landings';
import WebOffer from '../../components/WebOffer.astro';

const SITE = "https://chatbotia.cl";
const URL = `${SITE}/santiago/`;
const WA_NUMBER = "56961765268";
const WHATSAPP = `https://api.whatsapp.com/send?phone=${WA_NUMBER}&text=${encodeURIComponent("Hola, los contacto desde chatbotia.cl/santiago. Me interesa un chatbot con IA para mi negocio en Santiago.")}`;
const PHONE_DISPLAY = "+56 9 6176 5268";
const EMAIL = "codigoraul@gmail.com";
const FACEBOOK = "https://www.facebook.com/chatbotia.cl";
const DISENO_WEB = "https://diseñopaginas.cl";

const H1 = "Chatbot con IA en Santiago";
const TITLE = "Chatbot con IA en Santiago y Región Metropolitana | Chatia";
const DESCRIPTION = "Chat con IA para negocios de Santiago: responde a tus clientes las 24 horas en tu sitio web, filtra consultas y te deja sus datos listos. Desde $12.000 al mes, 100% online.";
const OG_IMAGE = `${SITE}/assets/img/brand/og-chatia.jpg`;
const IMG = "/assets/img";

const items = [
  {
    "icon": "ti-building-hospital",
    "title": "Clínicas y centros médicos",
    "text": "Especialidades, convenios, sedes en distintas comunas y cómo solicitar hora.",
    "q": "¿Atienden por Fonasa en la sede de Ñuñoa?"
  },
  {
    "icon": "ti-package",
    "title": "Tiendas online y comercio",
    "text": "Stock, plazos de despacho en el Gran Santiago, retiro en tienda y medios de pago.",
    "q": "¿Despachan hoy a Las Condes?"
  },
  {
    "icon": "ti-briefcase",
    "title": "Estudios y servicios profesionales",
    "text": "Contadores, abogados y consultoras: qué servicios ofrecen y cómo agendar una reunión.",
    "q": "¿Hacen declaración de renta para pymes?"
  },
  {
    "icon": "ti-school",
    "title": "Institutos, academias y preuniversitarios",
    "text": "Programas, fechas de matrícula, horarios, valores y requisitos de ingreso.",
    "q": "¿Cuándo parte la próxima generación?"
  },
  {
    "icon": "ti-building-community",
    "title": "Inmobiliarias y constructoras",
    "text": "Proyectos, tipologías y plazos de entrega, con el contacto del interesado calificado.",
    "q": "¿Tienen departamentos de 2 dormitorios cerca del metro?"
  },
  {
    "icon": "ti-chef-hat",
    "title": "Gastronomía, eventos y banquetería",
    "text": "Cartas, cotizaciones por cantidad de personas y fechas disponibles para eventos.",
    "q": "¿Cuánto cuesta un cóctel para 60 personas?"
  }
];

const faqs = [
  {
    "q": "¿Cómo me sirve un chatbot con IA si mi negocio está en Santiago?",
    "a": "En una ciudad con tanta competencia, responder primero puede definir la venta o la reserva. El chatbot contesta en tu página en cualquier momento, con tu información, y te deja los datos de quien se interesó para que lo retomes cuando puedas."
  },
  {
    "q": "¿Tienen oficina en Santiago?",
    "a": "No, Chatia trabaja 100% online. Coordinamos por WhatsApp y correo con negocios de cualquier comuna de la Región Metropolitana y del resto del país, y todo el proceso se hace a distancia."
  },
  {
    "q": "¿Sirve para tiendas online con despacho?",
    "a": "Sí. Puede informar plazos y comunas de despacho, medios de pago, políticas de cambio y retiro en tienda, y tomar el contacto cuando un cliente tenga una duda que requiera a una persona."
  },
  {
    "q": "¿Puede atender varias sedes en distintas comunas?",
    "a": "Sí. En el plan de $16.000 CLP puedes tener hasta dos chatbots, por ejemplo uno para cada sitio o sucursal. Para más de dos conversamos una propuesta."
  },
  {
    "q": "¿Qué pasa si el chatbot no sabe algo?",
    "a": "No improvisa. Reconoce que no tiene el dato y pide el nombre y el contacto del visitante para que tu equipo conteste."
  },
  {
    "q": "¿Cuál es el precio?",
    "a": "Hay dos planes mensuales: $12.000 CLP (1.000 respuestas al mes, un chatbot) y $16.000 CLP (2.000 respuestas, hasta dos chatbots). La instalación se paga una vez: $4.000 CLP. Pago por transferencia, con boleta de honorarios y sin permanencia forzosa."
  },
  {
    "q": "¿Cuánto demora en quedar funcionando?",
    "a": "Después de recibir la información de tu negocio, el chatbot queda instalado y respondiendo en 24 horas."
  },
  {
    "q": "¿Necesito saber de tecnología?",
    "a": "No. Nosotros lo configuramos, lo entrenamos y lo instalamos. Funciona en WordPress, en sitios a medida y en la mayoría de las plataformas que permiten agregar un código."
  },
  {
    "q": "¿Y si mi sitio está desactualizado?",
    "a": "Podemos rediseñarlo desde DiseñoPáginas.cl y entregarlo con el chatbot funcionando. La página se cotiza aparte."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Chatbot con IA para negocios de Santiago",
    "serviceType": "Chatbot con inteligencia artificial para páginas web",
    "provider": {
      "@type": "Organization",
      "name": "Chatia",
      "url": SITE,
      "logo": `${SITE}/assets/img/brand/chatia-icon-512.png`,
      "email": EMAIL,
      "telephone": "+56961765268",
      "sameAs": [FACEBOOK],
    },
    "areaServed": [
        {
            "@type": "City",
            "name": "Santiago"
        },
        {
            "@type": "AdministrativeArea",
            "name": "Región Metropolitana de Santiago"
        }
    ],
    "offers": [
        {
            "@type": "Offer",
            "name": "Plan Pymes",
            "price": "12000",
            "priceCurrency": "CLP"
        },
        {
            "@type": "Offer",
            "name": "Plan Empresas",
            "price": "16000",
            "priceCurrency": "CLP"
        }
    ]
},
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Chatia", "item": `${SITE}/` },
      { "@type": "ListItem", "position": 2, "name": "Chatbot con IA en Santiago", "item": URL },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  },
];
---

<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION} />
  <link rel="canonical" href={URL} />
  <meta name="theme-color" content="#F5C842" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={URL} />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:site_name" content="Chatia" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/dist/tabler-icons.min.css" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body class="vertical v-city">
  <div class="topbar">
    <div class="container">
      <a href={WHATSAPP} target="_blank" rel="noopener"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
      <a href={`mailto:${EMAIL}`}><i class="ti ti-mail"></i> {EMAIL}</a>
      <span><i class="ti ti-map-pin"></i> Atendemos Santiago y todo Chile</span>
      <a href={FACEBOOK} target="_blank" rel="noopener" class="topbar-social" aria-label="Chatbotia en Facebook"><i class="ti ti-brand-facebook"></i> Facebook</a>
    </div>
  </div>

  <header class="header-main">
    <div class="container">
      <a href="/" class="brand" aria-label="Chatia, inicio">
        <img src={`${IMG}/brand/chatia-logo-h.webp`} alt="Chatia – Chatbot con IA" width="565" height="120" loading="eager" />
      </a>
      <div class="header-cta">
        <a href={WHATSAPP} target="_blank" rel="noopener" class="header-phone"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
        <a href="#contacto" class="btn btn-yellow">Cotizar gratis</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="vtag"><i class="ti ti-map-pin"></i> Santiago y Región Metropolitana</span>
        <h1>{H1}</h1>
        <p class="lead">
          En una ciudad donde tus clientes comparan cinco sitios en el metro, responder primero marca la diferencia. Un asistente con IA atiende el chat de tu página en cualquier momento, resuelve lo habitual y te deja el contacto listo.
        </p>
        <div class="hero-buttons">
          <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
          <a href="#planes" class="btn btn-white btn-lg">Ver planes</a>
        </div>
        <ul class="hero-facts">
          <li>Listo en 24 horas</li>
          <li>Desde $12.000 al mes</li>
          <li>Sin permanencia</li>
        </ul>
      </div>

      <div class="chat-preview" aria-label="Ejemplo de conversación con un chatbot con IA para un centro médico en Santiago">
        <div class="chat-preview-head">
          <img src={`${IMG}/brand/chatia-avatar.webp`} alt="" width="40" height="40" />
          <div>
            <strong>Asistente Centro Médico</strong>
            <span><span class="dot"></span> Responde al instante</span>
          </div>
        </div>
        <div class="chat-preview-body">
          <div class="cp-msg cp-user">Hola, ¿tienen hora con traumatólogo esta semana en Providencia?</div>
          <div class="cp-msg cp-bot">¡Hola! El centro atiende traumatología en su sede de Providencia. ¿Me dejas tu nombre, teléfono y si vas por Fonasa o isapre para que coordinen la hora contigo?</div>
          <div class="cp-msg cp-user">Isapre. Soy Andrea, 9 3322 4455.</div>
          <div class="cp-msg cp-bot">Gracias, Andrea. Dejé tu solicitud y el equipo te contacta hoy para ofrecerte horarios. Si tu molestia es urgente, avísame y te indico cómo comunicarte de inmediato.</div>
        </div>
        <p class="cp-note">Ejemplo de un chatbot con IA para un centro médico en Santiago</p>
      </div>
    </div>
  </section>

  <nav class="subnav" aria-label="Secciones">
    <div class="container">
      <ul>
        <li><a href="#que-es">Qué es</a></li>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#rubros">Rubros</a></li>
        <li><a href="#online">100% online</a></li>
        <li><a href="#planes">Planes</a></li>
        <li><a href="#pagina-web">Página web</a></li>
        <li><a href="#faq">Preguntas frecuentes</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </div>
  </nav>

  <!-- Qué es -->
  <section id="que-es" class="band">
    <div class="container about-grid">
      <div>
        <h2>¿Qué es un chat con IA para negocios de Santiago?</h2>
        <p class="intro">
          Es un asistente de chat en la página de tu negocio. Conversa con quienes la visitan, responde servicios, precios, horarios y despachos, y recoge sus datos. En una ciudad con tanta oferta, que alguien reciba respuesta en segundos influye en a quién le compra o a quién le escribe después.
        </p>
        <ul class="feature-list">
          <li>
            <span class="ico"><i class="ti ti-bolt"></i></span>
            <div><strong>Respuesta inmediata</strong><span>Con la información real de tu negocio: servicios, tarifas, comunas de despacho o sedes, y preguntas frecuentes.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-route"></i></span>
            <div><strong>Evita idas y vueltas</strong><span>Pide los datos clave en la primera conversación, para que tu equipo no tenga que repetir preguntas por correo.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-moon-stars"></i></span>
            <div><strong>Atiende fuera de horario</strong><span>Muchas consultas llegan en la noche o el domingo; el chatbot las toma y las deja ordenadas para el lunes.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-shield-check"></i></span>
            <div><strong>No inventa respuestas</strong><span>Si no tiene un dato, lo dice y pide el contacto para que alguien de tu equipo responda.</span></div>
          </li>
        </ul>
      </div>
      <div>
      <figure class="photo"><img src={`${IMG}/ciudades/santiago-panoramica.webp`} alt="Vista aérea de Santiago de Chile con edificios y la cordillera de fondo" width="1500" height="1000" loading="lazy" /></figure>
      <div class="quote-box">
        <h3>En Santiago, la competencia está a un clic</h3>
        <p>Quien busca un servicio en la capital suele abrir varias páginas a la vez y escribir a las primeras que le inspiran confianza. Si la tuya no contesta, el cliente sigue con la siguiente.</p>
        <p class="mb-0">Con un chatbot, tu sitio responde de inmediato y deja la consulta registrada, aunque tu equipo esté en reunión, en terreno o ya haya cerrado.</p>
      </div>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section id="como-funciona" class="band band-dark">
    <div class="container">
      <div class="band-head">
        <h2>Cómo funciona</h2>
        <p>Tres pasos, sin programar y sin parar tu operación.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-num">1</span>
          <h3>Nos cuentas tu negocio</h3>
          <p>Servicios, valores, horarios, sedes o comunas de despacho y las preguntas que más te hacen. Decides qué se informa.</p>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <h3>Entrenamos tu asistente</h3>
          <p>La IA aprende solo con tu información y queda lista para atender con el tono de tu marca.</p>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <h3>Lo instalamos en tu página</h3>
          <p>En 24 horas atiende a tus visitantes y te escribe por correo cada vez que alguien deja sus datos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Rubros -->
  <section id="rubros" class="band band-yellow">
    <div class="container">
      <div class="band-head">
        <h2>Chatbot con IA para los negocios de la capital</h2>
        <p>Cada rubro tiene sus propias preguntas; lo configuramos con las tuyas.</p>
      </div>
      <div class="rubros rubros-3">
        {items.map((r) => (
          <div class="rubro">
            <div class="bubble">{r.q}</div>
            <h3 class="rubro-name"><i class={`ti ${r.icon}`}></i> {r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
      <p class="plans-note" style="margin-top:24px">
        También tenemos páginas especializadas para
        {landings.map((l, i) => (
          <>{i > 0 ? (i === landings.length - 1 ? " y " : ", ") : " "}<a href={l.href}>{l.short}</a></>
        ))}.
      </p>
    </div>
  </section>

  <!-- Atención online -->
  <section id="online" class="band">
    <div class="container about-grid">
      <div>
        <h2>Atención 100% online para toda la Región Metropolitana</h2>
        <p class="intro">
          No necesitas reunirte en una oficina ni cruzar la ciudad: el proceso completo se coordina por WhatsApp y correo, y el chatbot queda funcionando en tu página en 24 horas.
        </p>
        <ul class="feature-list">
          <li>
            <span class="ico"><i class="ti ti-brand-whatsapp"></i></span>
            <div><strong>Una persona al otro lado</strong><span>Hablas con quien configura tu chatbot, por WhatsApp, no con un formulario sin respuesta.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-map-2"></i></span>
            <div><strong>De Maipú a Las Condes</strong><span>Atendemos negocios de cualquier comuna de Santiago y la región, de la misma forma.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-adjustments"></i></span>
            <div><strong>Tú decides qué informa</strong><span>Tarifas, promociones, horarios de sedes o plazos: el bot usa solo lo que autorizas.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-calendar-off"></i></span>
            <div><strong>Mensual y sin permanencia</strong><span>Puedes ajustar o cancelar cuando lo necesites, sin multas ni contrato largo.</span></div>
          </li>
        </ul>
      </div>
      <div>
      <div class="quote-box">
        <h3>Pruébalo con tu propio rubro</h3>
        <p>Abre el chat de esta página y escribe como lo haría tu cliente: una consulta de precios, de horarios o de despacho. Puedes pedirle que actúe como asistente de un negocio santiaguino.</p>
        <p class="mb-0"><button type="button" class="btn btn-dark" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button></p>
      </div>
      </div>
    </div>
  </section>

  <!-- Planes -->
  <section id="planes" class="band band-soft">
    <div class="container">
      <div class="band-head">
        <h2>Planes y precios</h2>
        <p>Chatbot con IA para tu negocio en Santiago, con precios fijos y claros.</p>
      </div>
      <div class="plans">
        <div class="plan">
          <h3>Pymes</h3>
          <p class="price">$12.000 <span>CLP al mes</span></p>
          <ul>
            <li><i class="ti ti-check"></i> <span><strong>1.000 respuestas al mes</strong> (aprox. 250 conversaciones)</span></li>
            <li><i class="ti ti-check"></i> 1 chatbot instalado en tu página web</li>
            <li><i class="ti ti-check"></i> Entrenado con la información de tu negocio</li>
            <li><i class="ti ti-check"></i> Historial de conversaciones</li>
            <li><i class="ti ti-check"></i> Aviso por correo de cada contacto</li>
            <li><i class="ti ti-check"></i> Actualización de la información 1 vez al mes</li>
          </ul>
          <a href="#contacto" class="btn btn-white btn-block" data-plan="Plan Pymes - $12.000 CLP/mes">Cotizar plan Pymes</a>
        </div>
        <div class="plan featured">
          <span class="plan-tag">Más elegido</span>
          <h3>Empresas con más volumen</h3>
          <p class="price">$16.000 <span>CLP al mes</span></p>
          <ul>
            <li><i class="ti ti-check"></i> <span><strong>2.000 respuestas al mes</strong> (aprox. 500 conversaciones)</span></li>
            <li><i class="ti ti-check"></i> Hasta 2 chatbots (otra sede o sitio)</li>
            <li><i class="ti ti-check"></i> Entrenado con la información de tu negocio</li>
            <li><i class="ti ti-check"></i> Historial de conversaciones</li>
            <li><i class="ti ti-check"></i> Aviso por correo de cada contacto</li>
            <li><i class="ti ti-check"></i> Actualizaciones de información ilimitadas</li>
          </ul>
          <a href="#contacto" class="btn btn-dark btn-block" data-plan="Plan Empresas - $16.000 CLP/mes">Cotizar plan Empresas</a>
        </div>
      </div>
      <p class="plans-note">Instalación: pago único de $4.000 CLP. Mensualidad por transferencia bancaria, con boleta de honorarios. Sin permanencia forzosa.</p>
    </div>
  </section>

  <!-- Diseño o rediseño web (oferta secundaria) -->
  <WebOffer
    title={"¿Tu negocio no tiene página web, o la actual ya no compite?"}
    intro={"El chatbot atiende dentro de tu sitio. DiseñoPáginas.cl puede crear la página de tu negocio en Santiago o rediseñar la que tienes, y entregarla con el asistente ya instalado."}
    items={[
    {
        "icon": "ti-search",
        "title": "Visible donde te buscan",
        "text": "Una página pensada para aparecer cuando buscan tu servicio en tu comuna o en toda la ciudad."
    },
    {
        "icon": "ti-device-mobile",
        "title": "Hecha para el celular",
        "text": "La mayoría navega desde el teléfono; tu sitio carga rápido y se lee bien en pantallas pequeñas."
    },
    {
        "icon": "ti-message-circle",
        "title": "Con el chatbot incluido",
        "text": "Sale preparada para atender consultas desde el primer día."
    }
]}
    quoteTitle={"Primero el chatbot; el sitio, si lo necesitas"}
    quoteParagraphs={[
    "Si ya tienes un sitio que funciona, instalamos el asistente en él. Si está anticuado o no tienes uno, lo creamos o rediseñamos y lo dejamos funcionando con el chatbot.",
    "La página web se cotiza aparte, según lo que necesite tu negocio."
]}
    href={DISENO_WEB}
  />

  <!-- FAQ -->
  <section id="faq" class="band">
    <div class="container">
      <div class="band-head">
        <h2>Preguntas frecuentes</h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <div class={`faq-item${i === 0 ? " open" : ""}`}>
            <button class="faq-q" type="button" aria-expanded={i === 0 ? "true" : "false"}>
              {f.q}
              <i class="ti ti-chevron-down chev"></i>
            </button>
            <div class="faq-a"><div class="faq-a-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="band band-soft">
    <div class="container contact-grid">
      <div>
        <h2>Cotiza tu chatbot con IA en Santiago</h2>
        <p class="intro" style="font-size:1.15rem;color:#4a4f56">Cuéntanos de tu negocio y te enviamos una propuesta sin compromiso.</p>
        <div class="contact-direct">
          <a href={WHATSAPP} target="_blank" rel="noopener"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
          <a href={`mailto:${EMAIL}`}><i class="ti ti-mail"></i> {EMAIL}</a>
          <a href={FACEBOOK} target="_blank" rel="noopener"><i class="ti ti-brand-facebook"></i> facebook.com/chatbotia.cl</a>
        </div>
      </div>
      <div class="contact-form">
        <h3 class="contact-form-title">Formulario de contacto</h3>
        <form class="form-grid" id="contactForm">
          <input type="text" name="nombre" placeholder="Nombre" aria-label="Nombre" required />
          <input type="tel" name="fono" placeholder="Teléfono" aria-label="Teléfono" required />
          <input type="email" name="email" placeholder="Email" aria-label="Email" required />
          <select name="plan" id="planSelect" aria-label="Plan de interés" required>
            <option value="">¿Qué plan te interesa?</option>
            <option value="Plan Pymes - $12.000 CLP/mes">Plan Pymes ($12.000 al mes)</option>
            <option value="Plan Empresas - $16.000 CLP/mes">Plan Empresas ($16.000 al mes)</option>
            <option value="Chatbot + página web nueva o rediseño">Chatbot y página web (nueva o rediseño)</option>
            <option value="No estoy seguro, quiero asesoría">No estoy seguro, quiero asesoría</option>
          </select>
          <input class="full" type="text" name="web" placeholder="Página web de tu negocio (si tienes)" aria-label="Página web" />
          <textarea class="full" name="mensaje" placeholder="¿A qué se dedica tu negocio?" aria-label="Mensaje" rows="4" required></textarea>
          <button type="submit" class="btn btn-dark btn-block full"><i class="ti ti-brand-whatsapp"></i> Enviar por WhatsApp</button>
        </form>
        <p class="form-note">Al enviar se abrirá WhatsApp con tu mensaje listo.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="band cta">
    <div class="container cta-inner">
      <h2>Que ninguna consulta de tus clientes de Santiago se quede esperando</h2>
      <div class="cta-buttons">
        <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
        <a href={WHATSAPP} target="_blank" rel="noopener" class="btn btn-white btn-lg"><i class="ti ti-brand-whatsapp"></i> Escríbenos</a>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div>
          <img class="footer-logo" src={`${IMG}/brand/chatia-logo-h-white.webp`} alt="Chatia" width="565" height="120" loading="lazy" />
          <p style="max-width:420px">Chatia instala chatbots con inteligencia artificial en páginas web de pymes y empresas de Santiago y todo Chile, para que cada consulta tenga respuesta.</p>
        </div>
        <div>
          <h3>Chatbot por rubro</h3>
          <ul class="footer-links">
            {landings.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
            <li><a href="/#rubros">Ver todos los rubros</a></li>
          </ul>
        </div>
        <div>
          <h3>Chatbot por ciudad</h3>
          <ul class="footer-links">
            {ciudades.map((c) => (
              <li><a href={c.href}>{c.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Contacto</h3>
          <div class="footer-contact">
            <p><i class="ti ti-brand-whatsapp"></i> <a href={WHATSAPP} target="_blank" rel="noopener">{PHONE_DISPLAY}</a></p>
            <p><i class="ti ti-mail"></i> <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
            <p><i class="ti ti-brand-facebook"></i> <a href={FACEBOOK} target="_blank" rel="noopener">Síguenos en Facebook</a></p>
            <p><i class="ti ti-map-pin"></i> Atendemos Santiago y todo Chile</p>
            <p><i class="ti ti-clock"></i> Lunes a sábado</p>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="mb-0">&copy; {new Date().getFullYear()} Chatia, chatbot con IA en Chile</p>
        <p class="mb-0">Clientes: <a href="https://hielosdelsur.cl" target="_blank" rel="noopener">Hielos del Sur</a></p>
        <p class="mb-0">Un servicio de <a href="https://diseñopaginas.cl" target="_blank" rel="noopener">DiseñoPáginas.cl</a></p>
        <p class="mb-0"><a href="https://chatbotia.cl/">Chatbot con IA · chatbotia.cl</a></p>
      </div>
    </div>
  </footer>

  <DemoChatWidget
    vertical="santiago"
    botStatus="Asistente IA · Santiago"
    welcomeMessage="Hola, soy Chatia, un chatbot con IA. Así atendería a los clientes de tu negocio en Santiago, a cualquier hora. Pídeme que actúe como asistente de tu rubro, o pregúntame por el servicio."
    quickReplies={[
      { label: "Actúa como asistente de una tienda online", reply: "" },
      { label: "Tengo un negocio en Santiago, ¿cómo parto?", reply: "" },
      { label: "¿Cuánto cuesta?", reply: "" },
      { label: "¿Tienen oficina en Santiago?", reply: "" },
    ]}
    disclaimer="Esta es una demo real con IA. Tu chatbot se entrena con la información de tu negocio."
  />

  <script>
    document.querySelectorAll('.faq-item').forEach((item) => {
      const btn = item.querySelector('.faq-q');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach((el) => {
          el.classList.remove('open');
          el.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.querySelectorAll('[data-open-chat]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const root = document.getElementById('demoChat');
        const bubble = document.getElementById('demoChatBubble');
        if (root && bubble && !root.classList.contains('is-open')) bubble.click();
      });
    });

    const planSelect = document.getElementById('planSelect') as HTMLSelectElement | null;
    document.querySelectorAll('[data-plan]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (planSelect) planSelect.value = (btn as HTMLElement).dataset.plan || '';
      });
    });

    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const web = String(data.get('web') || '').trim();
      const text =
        `Hola, los contacto desde chatbotia.cl/santiago.\n` +
        `Nombre: ${data.get('nombre')}\nTeléfono: ${data.get('fono')}\nEmail: ${data.get('email')}\n` +
        `Plan: ${data.get('plan')}\n` +
        (web ? `Web: ${web}\n` : '') +
        `Negocio: ${data.get('mensaje')}`;
      window.open(`https://api.whatsapp.com/send?phone=56961765268&text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</body>
</html>
