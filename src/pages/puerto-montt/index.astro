---
import '../../styles/global.css';
import '../../styles/vertical.css';
import DemoChatWidget from '../../components/DemoChatWidget.astro';
import { landings, ciudades } from '../../data/landings';
import WebOffer from '../../components/WebOffer.astro';

const SITE = "https://chatbotia.cl";
const URL = `${SITE}/puerto-montt/`;
const WA_NUMBER = "56961765268";
const WHATSAPP = `https://api.whatsapp.com/send?phone=${WA_NUMBER}&text=${encodeURIComponent("Hola, los contacto desde chatbotia.cl/puerto-montt. Me interesa un chatbot con IA para mi negocio en Puerto Montt o la Región de Los Lagos.")}`;
const PHONE_DISPLAY = "+56 9 6176 5268";
const EMAIL = "codigoraul@gmail.com";
const FACEBOOK = "https://www.facebook.com/chatbotia.cl";
const DISENO_WEB = "https://diseñopaginas.cl";

const H1 = "Chatbot con IA en Puerto Montt";
const TITLE = "Chatbot con IA en Puerto Montt y Región de Los Lagos | Chatia";
const DESCRIPTION = "Chat con IA para negocios de Puerto Montt, Puerto Varas y la Región de Los Lagos: atiende consultas 24/7 en tu web, cotiza y deja los datos del cliente. Desde $12.000 al mes.";
const OG_IMAGE = `${SITE}/assets/img/brand/og-chatia.jpg`;
const IMG = "/assets/img";

const items = [
  {
    "icon": "ti-trees",
    "title": "Cabañas y alojamientos junto al lago",
    "text": "Capacidad, tinaja, mascotas y disponibilidad en Puerto Varas, Frutillar y alrededores.",
    "q": "¿Tienen cabaña para 6 con vista al volcán?"
  },
  {
    "icon": "ti-sailboat",
    "title": "Tours a Chiloé y a la Carretera Austral",
    "text": "Itinerarios, duración, incluidos y cómo coordinar traslados o cruces en transbordador.",
    "q": "¿Cuántos días recomiendan para Chiloé?"
  },
  {
    "icon": "ti-car",
    "title": "Arriendo de vehículos",
    "text": "Camionetas y autos, requisitos del conductor, kilometraje y retiro en el aeropuerto o en la ciudad.",
    "q": "¿Puedo llevar la camioneta a Chiloé?"
  },
  {
    "icon": "ti-fish",
    "title": "Proveedores para la acuicultura",
    "text": "Cotizaciones de insumos, servicios y mantención para centros de cultivo y empresas del rubro.",
    "q": "¿Hacen despachos a Calbuco y Chiloé?"
  },
  {
    "icon": "ti-soup",
    "title": "Gastronomía y mariscos",
    "text": "Cartas, reservas para grupos y horarios, para locales de Angelmó y de toda la zona.",
    "q": "¿Puedo reservar mesa para 8 personas?"
  },
  {
    "icon": "ti-building-store",
    "title": "Ferreterías y comercio del sur",
    "text": "Stock, retiro y despacho de materiales y productos para el clima del sur.",
    "q": "¿Tienen planchas de zinc en stock?"
  }
];

const faqs = [
  {
    "q": "¿Cómo me ayuda un chatbot con IA si tengo un negocio en Puerto Montt?",
    "a": "Te ayuda a no perder consultas: responde al instante con tu información, cotiza o toma los datos para cotizar, y te avisa por correo. Es útil tanto para turismo como para empresas que reciben solicitudes de proveedores o clientes de la región."
  },
  {
    "q": "¿Atienden en persona en Puerto Montt?",
    "a": "No, Chatia trabaja 100% online. Atendemos negocios de Puerto Montt y de toda la Región de Los Lagos como al resto del país, por WhatsApp y correo."
  },
  {
    "q": "¿Sirve para empresas que no son de turismo?",
    "a": "Sí. Un proveedor o taller puede usarlo para responder qué servicios ofrece, qué zonas cubre y cómo solicitar una cotización, y recibir esos datos ordenados."
  },
  {
    "q": "¿Puede cotizar automáticamente?",
    "a": "No calcula presupuestos por su cuenta. Informa lo que tú autorices (tarifas base, requisitos) y recoge los datos necesarios para que tú envíes la cotización final."
  },
  {
    "q": "¿Qué pasa si el chatbot no sabe una respuesta?",
    "a": "No inventa. Reconoce que no tiene el dato y pide nombre y contacto para que tu equipo conteste."
  },
  {
    "q": "¿Cuál es el costo?",
    "a": "Hay dos planes mensuales: $12.000 CLP (1.000 respuestas al mes, un chatbot) y $16.000 CLP (2.000 respuestas, hasta dos chatbots). La instalación es un pago único de $4.000 CLP. Se paga por transferencia, con boleta de honorarios y sin permanencia."
  },
  {
    "q": "¿Cuánto tarda en quedar activo?",
    "a": "Desde que nos entregas la información de tu negocio, queda instalado y respondiendo en 24 horas."
  },
  {
    "q": "¿Y si mi negocio no tiene sitio web?",
    "a": "Podemos crearlo desde DiseñoPáginas.cl y entregarlo con el chatbot instalado. La web se cotiza aparte; el asistente funciona en cualquier sitio que permita agregar un código."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Chatbot con IA para negocios de Puerto Montt",
    "serviceType": "Chatbot con inteligencia artificial para páginas web",
    "provider": {
      "@type": "Organization",
      "name": "Chatia",
      "url": SITE,
      "logo": `${SITE}/assets/img/brand/chatia-icon-512.png`,
      "email": EMAIL,
      "telephone": "+56961765268",
      "sameAs": [FACEBOOK],
    },
    "areaServed": [
        {
            "@type": "City",
            "name": "Puerto Montt"
        },
        {
            "@type": "City",
            "name": "Puerto Varas"
        },
        {
            "@type": "AdministrativeArea",
            "name": "Región de Los Lagos"
        }
    ],
    "offers": [
        {
            "@type": "Offer",
            "name": "Plan Pymes",
            "price": "12000",
            "priceCurrency": "CLP"
        },
        {
            "@type": "Offer",
            "name": "Plan Empresas",
            "price": "16000",
            "priceCurrency": "CLP"
        }
    ]
},
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Chatia", "item": `${SITE}/` },
      { "@type": "ListItem", "position": 2, "name": "Chatbot con IA en Puerto Montt", "item": URL },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  },
];
---

<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION} />
  <link rel="canonical" href={URL} />
  <meta name="theme-color" content="#F5C842" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={URL} />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:site_name" content="Chatia" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/dist/tabler-icons.min.css" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body class="vertical v-city">
  <div class="topbar">
    <div class="container">
      <a href={WHATSAPP} target="_blank" rel="noopener"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
      <a href={`mailto:${EMAIL}`}><i class="ti ti-mail"></i> {EMAIL}</a>
      <span><i class="ti ti-map-pin"></i> Atendemos Puerto Montt, Los Lagos y todo Chile</span>
      <a href={FACEBOOK} target="_blank" rel="noopener" class="topbar-social" aria-label="Chatbotia en Facebook"><i class="ti ti-brand-facebook"></i> Facebook</a>
    </div>
  </div>

  <header class="header-main">
    <div class="container">
      <a href="/" class="brand" aria-label="Chatia, inicio">
        <img src={`${IMG}/brand/chatia-logo-h.webp`} alt="Chatia – Chatbot con IA" width="565" height="120" loading="eager" />
      </a>
      <div class="header-cta">
        <a href={WHATSAPP} target="_blank" rel="noopener" class="header-phone"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
        <a href="#contacto" class="btn btn-yellow">Cotizar gratis</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="vtag"><i class="ti ti-map-pin"></i> Puerto Montt y Región de Los Lagos</span>
        <h1>{H1}</h1>
        <p class="lead">
          Puerto Montt es la puerta a los lagos, a Chiloé y a la Carretera Austral, y también un polo de empresas del sur. Un asistente con IA atiende tu sitio a toda hora, responde a turistas y a clientes que piden cotización, y te deja su contacto.
        </p>
        <div class="hero-buttons">
          <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
          <a href="#planes" class="btn btn-white btn-lg">Ver planes</a>
        </div>
        <ul class="hero-facts">
          <li>Listo en 24 horas</li>
          <li>Desde $12.000 al mes</li>
          <li>Sin permanencia</li>
        </ul>
      </div>

      <div class="chat-preview" aria-label="Ejemplo de conversación con un chatbot con IA para una empresa de arriendo de camionetas en Puerto Montt">
        <div class="chat-preview-head">
          <img src={`${IMG}/brand/chatia-avatar.webp`} alt="" width="40" height="40" />
          <div>
            <strong>Asistente Arriendo de Camionetas</strong>
            <span><span class="dot"></span> Responde al instante</span>
          </div>
        </div>
        <div class="chat-preview-body">
          <div class="cp-msg cp-user">Hola, ¿tienen camioneta 4x4 para recorrer la Carretera Austral? Serían 8 días desde Puerto Montt.</div>
          <div class="cp-msg cp-bot">¡Hola! Sí, tenemos camionetas 4x4 y podemos retirarlas en Puerto Montt. Para cotizar los 8 días, ¿me dejas tu nombre, teléfono y las fechas de salida y regreso?</div>
          <div class="cp-msg cp-user">Soy Sebastián, 9 6677 8899. Salimos el 10 y volvemos el 18.</div>
          <div class="cp-msg cp-bot">Gracias, Sebastián. Anoté tu solicitud del 10 al 18 y el equipo te envía hoy la cotización, con los requisitos para cruzar tramos de ripio y para llevar el vehículo a Chiloé.</div>
        </div>
        <p class="cp-note">Ejemplo de un chatbot con IA para un arriendo de camionetas en Puerto Montt</p>
      </div>
    </div>
  </section>

  <nav class="subnav" aria-label="Secciones">
    <div class="container">
      <ul>
        <li><a href="#que-es">Qué es</a></li>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#rubros">Rubros</a></li>
        <li><a href="#online">100% online</a></li>
        <li><a href="#planes">Planes</a></li>
        <li><a href="#pagina-web">Página web</a></li>
        <li><a href="#faq">Preguntas frecuentes</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </div>
  </nav>

  <!-- Qué es -->
  <section id="que-es" class="band">
    <div class="container about-grid">
      <div>
        <h2>¿Qué es un chat con IA para negocios de Puerto Montt?</h2>
        <p class="intro">
          Es un asistente con inteligencia artificial instalado en la página de tu negocio. Contesta a quien llega buscando un alojamiento, un tour, un arriendo o un proveedor, con la información que tú le entregas, y registra quién es y qué necesita. En el sur, donde muchas consultas llegan antes de viajar, ese primer mensaje cuenta.
        </p>
        <ul class="feature-list">
          <li>
            <span class="ico"><i class="ti ti-compass"></i></span>
            <div><strong>Planifica con el visitante</strong><span>Responde rutas, tiempos, qué incluye cada servicio y cómo llegar, con los datos de tu negocio.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-file-invoice"></i></span>
            <div><strong>Toma la cotización</strong><span>Pide fechas, cantidad de personas o requisitos, y te deja un resumen para responder con una oferta.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-clock-bolt"></i></span>
            <div><strong>No depende de tu horario</strong><span>Contesta cuando estás en terreno, navegando o fuera de la oficina.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-shield-check"></i></span>
            <div><strong>Sin inventar datos</strong><span>Si falta información, lo reconoce y pide el contacto para que tú respondas.</span></div>
          </li>
        </ul>
      </div>
      <div>
      <div class="quote-box">
        <h3>Quien viaja al sur pregunta con anticipación</h3>
        <p>Muchos visitantes escriben desde otras ciudades o países semanas antes de llegar, y comparan varias opciones a la vez. La primera que responde con claridad suele quedarse con la reserva.</p>
        <p class="mb-0">Un chatbot hace que tu negocio conteste de inmediato, aunque tengas un grupo en ruta o sea fin de semana, y que no se pierda una cotización por demora.</p>
      </div>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section id="como-funciona" class="band band-dark">
    <div class="container">
      <div class="band-head">
        <h2>Cómo funciona</h2>
        <p>Tres pasos, sin programar y sin dejar tu operación.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-num">1</span>
          <h3>Nos cuentas cómo trabajas</h3>
          <p>Servicios, tarifas, temporadas, zonas de cobertura y las preguntas que más recibes.</p>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <h3>Entrenamos el asistente</h3>
          <p>Aprende solo de tu información y queda listo para atender con el tono de tu empresa.</p>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <h3>Lo instalamos en tu página</h3>
          <p>En 24 horas empieza a atender y te avisa por correo cuando alguien deja sus datos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Rubros -->
  <section id="rubros" class="band band-yellow">
    <div class="container">
      <div class="band-head">
        <h2>Chatbot con IA para los negocios de Puerto Montt y la región</h2>
        <p>Cada rubro del sur recibe consultas distintas; el chatbot se prepara con las tuyas.</p>
      </div>
      <div class="rubros rubros-3">
        {items.map((r) => (
          <div class="rubro">
            <div class="bubble">{r.q}</div>
            <h3 class="rubro-name"><i class={`ti ${r.icon}`}></i> {r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
      <p class="plans-note" style="margin-top:24px">
        También tenemos páginas especializadas para
        {landings.map((l, i) => (
          <>{i > 0 ? (i === landings.length - 1 ? " y " : ", ") : " "}<a href={l.href}>{l.short}</a></>
        ))}.
      </p>
    </div>
  </section>

  <!-- Atención online -->
  <section id="online" class="band">
    <div class="container about-grid">
      <div>
        <h2>Atención 100% online para toda la Región de Los Lagos</h2>
        <p class="intro">
          No necesitas viajar ni coordinar visitas: todo se resuelve a distancia por WhatsApp y correo, y tu chatbot queda activo en tu sitio en 24 horas.
        </p>
        <ul class="feature-list">
          <li>
            <span class="ico"><i class="ti ti-brand-whatsapp"></i></span>
            <div><strong>Contacto directo</strong><span>Hablas con quien configura tu chatbot, sin formularios que se pierden.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-map-2"></i></span>
            <div><strong>Desde Puerto Montt hacia el sur</strong><span>Puerto Varas, Frutillar, Osorno, Ancud, Castro y el resto de la región.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-adjustments"></i></span>
            <div><strong>Tú controlas lo que informa</strong><span>Tarifas, cupos de temporada o plazos de despacho: el bot solo usa lo que autorizas.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-calendar-off"></i></span>
            <div><strong>Sin permanencia forzosa</strong><span>Plan mensual que puedes ajustar según tu temporada.</span></div>
          </li>
        </ul>
      </div>
      <div>
      <div class="quote-box">
        <h3>Pruébalo como lo haría un viajero</h3>
        <p>Abre el chat de esta página y escribe como alguien que planea un viaje al sur: una consulta de arriendo, de tour o de alojamiento. Puedes pedirle que actúe como asistente de un negocio de Puerto Montt.</p>
        <p class="mb-0"><button type="button" class="btn btn-dark" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button></p>
      </div>
      </div>
    </div>
  </section>

  <!-- Planes -->
  <section id="planes" class="band band-soft">
    <div class="container">
      <div class="band-head">
        <h2>Planes y precios</h2>
        <p>Chatbot con IA para tu negocio en Puerto Montt, con precios fijos y claros.</p>
      </div>
      <div class="plans">
        <div class="plan">
          <h3>Pymes</h3>
          <p class="price">$12.000 <span>CLP al mes</span></p>
          <ul>
            <li><i class="ti ti-check"></i> <span><strong>1.000 respuestas al mes</strong> (aprox. 250 conversaciones)</span></li>
            <li><i class="ti ti-check"></i> 1 chatbot instalado en tu página web</li>
            <li><i class="ti ti-check"></i> Entrenado con la información de tu negocio</li>
            <li><i class="ti ti-check"></i> Historial de conversaciones</li>
            <li><i class="ti ti-check"></i> Aviso por correo de cada contacto</li>
            <li><i class="ti ti-check"></i> Actualización de la información 1 vez al mes</li>
          </ul>
          <a href="#contacto" class="btn btn-white btn-block" data-plan="Plan Pymes - $12.000 CLP/mes">Cotizar plan Pymes</a>
        </div>
        <div class="plan featured">
          <span class="plan-tag">Más elegido</span>
          <h3>Empresas</h3>
          <p class="price">$16.000 <span>CLP al mes</span></p>
          <ul>
            <li><i class="ti ti-check"></i> <span><strong>2.000 respuestas al mes</strong> (aprox. 500 conversaciones)</span></li>
            <li><i class="ti ti-check"></i> Hasta 2 chatbots (otro sitio o sucursal)</li>
            <li><i class="ti ti-check"></i> Entrenado con la información de tu negocio</li>
            <li><i class="ti ti-check"></i> Historial de conversaciones</li>
            <li><i class="ti ti-check"></i> Aviso por correo de cada contacto</li>
            <li><i class="ti ti-check"></i> Actualizaciones de información ilimitadas</li>
          </ul>
          <a href="#contacto" class="btn btn-dark btn-block" data-plan="Plan Empresas - $16.000 CLP/mes">Cotizar plan Empresas</a>
        </div>
      </div>
      <p class="plans-note">Instalación: pago único de $4.000 CLP. Mensualidad por transferencia bancaria, con boleta de honorarios. Sin permanencia forzosa.</p>
    </div>
  </section>

  <!-- Diseño o rediseño web (oferta secundaria) -->
  <WebOffer
    title={"¿Tu negocio no tiene página web, o la actual quedó antigua?"}
    intro={"El chatbot atiende dentro de tu sitio. DiseñoPáginas.cl puede crear la página de tu negocio en Puerto Montt o rediseñar la actual, y entregarla con el asistente ya instalado."}
    items={[
    {
        "icon": "ti-world-search",
        "title": "Visible para quien planea su viaje",
        "text": "Que turistas y empresas encuentren tu sitio cuando buscan tu servicio en el sur."
    },
    {
        "icon": "ti-mountain",
        "title": "Muestra tu entorno",
        "text": "Fotos y textos que transmiten lo que ofreces, desde el lago hasta tu taller o tu local."
    },
    {
        "icon": "ti-message-circle",
        "title": "Con el chatbot incluido",
        "text": "La página sale preparada para atender cotizaciones y consultas desde el primer día."
    }
]}
    quoteTitle={"Primero el chatbot; la página, si la necesitas"}
    quoteParagraphs={[
    "Si ya tienes un sitio, instalamos el asistente ahí. Si solo usas redes sociales o plataformas de terceros, podemos crear tu propio sitio.",
    "La página web se cotiza aparte, según las necesidades de tu negocio."
]}
    href={DISENO_WEB}
  />

  <!-- FAQ -->
  <section id="faq" class="band">
    <div class="container">
      <div class="band-head">
        <h2>Preguntas frecuentes</h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <div class={`faq-item${i === 0 ? " open" : ""}`}>
            <button class="faq-q" type="button" aria-expanded={i === 0 ? "true" : "false"}>
              {f.q}
              <i class="ti ti-chevron-down chev"></i>
            </button>
            <div class="faq-a"><div class="faq-a-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="band band-soft">
    <div class="container contact-grid">
      <div>
        <h2>Cotiza tu chatbot con IA en Puerto Montt</h2>
        <p class="intro" style="font-size:1.15rem;color:#4a4f56">Cuéntanos de tu negocio y te enviamos una propuesta sin compromiso.</p>
        <div class="contact-direct">
          <a href={WHATSAPP} target="_blank" rel="noopener"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
          <a href={`mailto:${EMAIL}`}><i class="ti ti-mail"></i> {EMAIL}</a>
          <a href={FACEBOOK} target="_blank" rel="noopener"><i class="ti ti-brand-facebook"></i> facebook.com/chatbotia.cl</a>
        </div>
      </div>
      <div class="contact-form">
        <h3 class="contact-form-title">Formulario de contacto</h3>
        <form class="form-grid" id="contactForm">
          <input type="text" name="nombre" placeholder="Nombre" aria-label="Nombre" required />
          <input type="tel" name="fono" placeholder="Teléfono" aria-label="Teléfono" required />
          <input type="email" name="email" placeholder="Email" aria-label="Email" required />
          <select name="plan" id="planSelect" aria-label="Plan de interés" required>
            <option value="">¿Qué plan te interesa?</option>
            <option value="Plan Pymes - $12.000 CLP/mes">Plan Pymes ($12.000 al mes)</option>
            <option value="Plan Empresas - $16.000 CLP/mes">Plan Empresas ($16.000 al mes)</option>
            <option value="Chatbot + página web nueva o rediseño">Chatbot y página web (nueva o rediseño)</option>
            <option value="No estoy seguro, quiero asesoría">No estoy seguro, quiero asesoría</option>
          </select>
          <input class="full" type="text" name="web" placeholder="Página web de tu negocio (si tienes)" aria-label="Página web" />
          <textarea class="full" name="mensaje" placeholder="¿A qué se dedica tu negocio?" aria-label="Mensaje" rows="4" required></textarea>
          <button type="submit" class="btn btn-dark btn-block full"><i class="ti ti-brand-whatsapp"></i> Enviar por WhatsApp</button>
        </form>
        <p class="form-note">Al enviar se abrirá WhatsApp con tu mensaje listo.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="band cta">
    <div class="container cta-inner">
      <h2>Que ninguna cotización del sur se pierda por responder tarde</h2>
      <div class="cta-buttons">
        <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
        <a href={WHATSAPP} target="_blank" rel="noopener" class="btn btn-white btn-lg"><i class="ti ti-brand-whatsapp"></i> Escríbenos</a>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div>
          <img class="footer-logo" src={`${IMG}/brand/chatia-logo-h-white.webp`} alt="Chatia" width="565" height="120" loading="lazy" />
          <p style="max-width:420px">Chatia instala chatbots con inteligencia artificial en páginas web de pymes y empresas de Puerto Montt, la Región de Los Lagos y todo Chile.</p>
        </div>
        <div>
          <h3>Chatbot por rubro</h3>
          <ul class="footer-links">
            {landings.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
            <li><a href="/#rubros">Ver todos los rubros</a></li>
          </ul>
        </div>
        <div>
          <h3>Chatbot por ciudad</h3>
          <ul class="footer-links">
            {ciudades.map((c) => (
              <li><a href={c.href}>{c.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Contacto</h3>
          <div class="footer-contact">
            <p><i class="ti ti-brand-whatsapp"></i> <a href={WHATSAPP} target="_blank" rel="noopener">{PHONE_DISPLAY}</a></p>
            <p><i class="ti ti-mail"></i> <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
            <p><i class="ti ti-brand-facebook"></i> <a href={FACEBOOK} target="_blank" rel="noopener">Síguenos en Facebook</a></p>
            <p><i class="ti ti-map-pin"></i> Atendemos Puerto Montt, Los Lagos y todo Chile</p>
            <p><i class="ti ti-clock"></i> Lunes a sábado</p>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="mb-0">&copy; {new Date().getFullYear()} Chatia, chatbot con IA en Chile</p>
        <p class="mb-0">Clientes: <a href="https://hielosdelsur.cl" target="_blank" rel="noopener">Hielos del Sur</a></p>
        <p class="mb-0">Un servicio de <a href="https://diseñopaginas.cl" target="_blank" rel="noopener">DiseñoPáginas.cl</a></p>
      </div>
    </div>
  </footer>

  <DemoChatWidget
    vertical="puertomontt"
    botStatus="Asistente IA · Puerto Montt"
    welcomeMessage="Hola, soy Chatia, un chatbot con IA. Así atendería a los clientes de tu negocio en Puerto Montt o la Región de Los Lagos, a cualquier hora. Pídeme que actúe como asistente de tu rubro, o pregúntame por el servicio."
    quickReplies={[
      { label: "Actúa como asistente de unas cabañas", reply: "" },
      { label: "Tengo un negocio en Puerto Montt, ¿cómo parto?", reply: "" },
      { label: "¿Cuánto cuesta?", reply: "" },
      { label: "¿Tienen oficina en Puerto Montt?", reply: "" },
    ]}
    disclaimer="Esta es una demo real con IA. Tu chatbot se entrena con la información de tu negocio."
  />

  <script>
    document.querySelectorAll('.faq-item').forEach((item) => {
      const btn = item.querySelector('.faq-q');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach((el) => {
          el.classList.remove('open');
          el.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.querySelectorAll('[data-open-chat]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const root = document.getElementById('demoChat');
        const bubble = document.getElementById('demoChatBubble');
        if (root && bubble && !root.classList.contains('is-open')) bubble.click();
      });
    });

    const planSelect = document.getElementById('planSelect') as HTMLSelectElement | null;
    document.querySelectorAll('[data-plan]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (planSelect) planSelect.value = (btn as HTMLElement).dataset.plan || '';
      });
    });

    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const web = String(data.get('web') || '').trim();
      const text =
        `Hola, los contacto desde chatbotia.cl/puerto-montt.\n` +
        `Nombre: ${data.get('nombre')}\nTeléfono: ${data.get('fono')}\nEmail: ${data.get('email')}\n` +
        `Plan: ${data.get('plan')}\n` +
        (web ? `Web: ${web}\n` : '') +
        `Negocio: ${data.get('mensaje')}`;
      window.open(`https://api.whatsapp.com/send?phone=56961765268&text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</body>
</html>
