---
import '../../styles/global.css';
import '../../styles/vertical.css';
import DemoChatWidget from '../../components/DemoChatWidget.astro';
import { landings, ciudades } from '../../data/landings';
import WebOffer from '../../components/WebOffer.astro';

const SITE = "https://chatbotia.cl";
const URL = `${SITE}/la-serena/`;
const WA_NUMBER = "56961765268";
const WHATSAPP = `https://api.whatsapp.com/send?phone=${WA_NUMBER}&text=${encodeURIComponent("Hola, los contacto desde chatbotia.cl/la-serena. Me interesa un chatbot con IA para mi negocio en La Serena.")}`;
const PHONE_DISPLAY = "+56 9 6176 5268";
const EMAIL = "codigoraul@gmail.com";
const FACEBOOK = "https://www.facebook.com/chatbotia.cl";
const DISENO_WEB = "https://diseñopaginas.cl";

const H1 = "Chatbot con IA en La Serena";
const TITLE = "Chatbot con IA en La Serena y Región de Coquimbo | Chatia";
const DESCRIPTION = "Chat con IA para negocios de La Serena y Coquimbo: atiende a tus clientes 24/7 en tu página web, responde consultas y te deja sus datos. Desde $12.000 al mes, 100% online.";
const OG_IMAGE = `${SITE}/assets/img/brand/og-chatia.jpg`;
const IMG = "/assets/img";

const rubros = [
  { icon: "ti-beach", title: "Turismo y alojamiento", text: "Cabañas, hoteles, hostales, tours y excursiones al Valle del Elqui: precios, disponibilidad y cómo llegar, también fuera de horario.", q: "¿Tienen cabañas para 4 personas en enero?" },
  { icon: "ti-stethoscope", title: "Clínicas, dentistas y salud", text: "Prestaciones, horarios, convenios y solicitud de hora, sin que la secretaria deba contestar lo mismo todo el día.", q: "¿Atienden por Fonasa? ¿Cómo pido hora?" },
  { icon: "ti-home", title: "Inmobiliarias y corredores", text: "Propiedades, parcelas y arriendos: el bot filtra al interesado y deja nombre, teléfono y qué busca.", q: "¿Tienen parcelas con agua cerca de La Serena?" },
  { icon: "ti-tools-kitchen-2", title: "Restaurantes y gastronomía", text: "Carta, horarios, reservas para grupos y eventos, en el momento en que el cliente decide dónde ir.", q: "¿Pueden reservar para 10 personas el sábado?" },
  { icon: "ti-shopping-bag", title: "Comercio y servicios", text: "Ferreterías, ópticas, talleres y tiendas: stock, despacho a Coquimbo y la región, medios de pago.", q: "¿Despachan a Coquimbo y Ovalle?" },
  { icon: "ti-school", title: "Academias y educación", text: "Cursos, matrículas, horarios y valores, con los datos del interesado listos para contactar.", q: "¿Cuándo parte el próximo curso?" },
];

const faqs = [
  {
    q: "¿Qué es un chatbot con IA y cómo me sirve en La Serena?",
    a: "Es un chat con inteligencia artificial que se instala en la página web de tu negocio y conversa con quienes la visitan. Se entrena con tu información real (servicios, precios, horarios, ubicación, preguntas frecuentes), responde al instante y te deja los datos del interesado por correo. En una ciudad con tanto turismo y consultas fuera de horario, evita que se pierdan clientes que escriben de noche, en fin de semana o en plena temporada alta.",
  },
  {
    q: "¿Tienen oficina en La Serena?",
    a: "No: Chatia trabaja 100% online. Atendemos negocios de La Serena, Coquimbo y toda la Región de Coquimbo igual que al resto de Chile: coordinamos por WhatsApp o correo, configuramos tu chatbot a distancia y queda instalado en tu página web en 24 horas.",
  },
  {
    q: "¿Cuánto cuesta un chatbot con IA?",
    a: "Tenemos dos planes fijos: $12.000 CLP mensuales (1.000 respuestas al mes, 1 chatbot) y $16.000 CLP mensuales (2.000 respuestas al mes, hasta 2 chatbots). La instalación es un pago único de $4.000 CLP. Pago mensual por transferencia, con boleta de honorarios y sin permanencia forzosa.",
  },
  {
    q: "¿Funciona si mi negocio es de temporada, por ejemplo turismo?",
    a: "Sí. Como los planes son mensuales y sin permanencia forzosa, puedes mantener el chatbot durante la temporada alta y ajustar después. Además, la información (tarifas, disponibilidad, horarios de temporada) se actualiza cuando lo necesites.",
  },
  {
    q: "¿Qué pasa si el chatbot no sabe una respuesta?",
    a: "Está configurado para no inventar. Si no tiene la información, se lo dice al visitante y lo invita a dejar su nombre y contacto para que tu negocio le responda.",
  },
  {
    q: "¿Cuánto demora la instalación?",
    a: "Una vez que nos envías la información de tu negocio, el chatbot queda instalado y respondiendo en 24 horas.",
  },
  {
    q: "¿Y si mi negocio no tiene página web o la mía está desactualizada?",
    a: "Te la podemos crear o rediseñar: DiseñoPáginas.cl diseña páginas web para negocios de todo Chile y el chatbot se instala en ella. La página se cotiza aparte; el chatbot funciona en cualquier sitio web que permita agregar un código.",
  },
  {
    q: "¿Necesito saber programar?",
    a: "No. Nosotros configuramos el chatbot, lo entrenamos y lo instalamos en tu página web. Funciona en WordPress, sitios a medida y la mayoría de plataformas que permiten agregar un código.",
  },
  {
    q: "¿Funciona con WhatsApp?",
    a: "Por ahora el servicio está enfocado en tu página web. Si más adelante quieres atención automática por WhatsApp Business, lo evaluamos como una ampliación aparte.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Chatbot con IA para negocios de La Serena",
    "serviceType": "Chatbot con inteligencia artificial para páginas web",
    "provider": {
      "@type": "Organization",
      "name": "Chatia",
      "url": SITE,
      "logo": `${SITE}/assets/img/brand/chatia-icon-512.png`,
      "email": EMAIL,
      "telephone": "+56961765268",
      "sameAs": [FACEBOOK],
    },
    "areaServed": [
      { "@type": "City", "name": "La Serena" },
      { "@type": "City", "name": "Coquimbo" },
      { "@type": "AdministrativeArea", "name": "Región de Coquimbo" },
    ],
    "offers": [
      { "@type": "Offer", "name": "Plan Pymes", "price": "12000", "priceCurrency": "CLP" },
      { "@type": "Offer", "name": "Plan Empresas", "price": "16000", "priceCurrency": "CLP" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Chatia", "item": `${SITE}/` },
      { "@type": "ListItem", "position": 2, "name": "Chatbot con IA en La Serena", "item": URL },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  },
];
---

<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION} />
  <link rel="canonical" href={URL} />
  <meta name="theme-color" content="#F5C842" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={URL} />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:site_name" content="Chatia" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/dist/tabler-icons.min.css" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body class="vertical v-city">
  <div class="topbar">
    <div class="container">
      <a href={WHATSAPP} target="_blank" rel="noopener"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
      <a href={`mailto:${EMAIL}`}><i class="ti ti-mail"></i> {EMAIL}</a>
      <span><i class="ti ti-map-pin"></i> Atendemos La Serena y todo Chile</span>
      <a href={FACEBOOK} target="_blank" rel="noopener" class="topbar-social" aria-label="Chatbotia en Facebook"><i class="ti ti-brand-facebook"></i> Facebook</a>
    </div>
  </div>

  <header class="header-main">
    <div class="container">
      <a href="/" class="brand" aria-label="Chatia, inicio">
        <img src={`${IMG}/brand/chatia-logo-h.webp`} alt="Chatia – Chatbot con IA" width="565" height="120" loading="eager" />
      </a>
      <div class="header-cta">
        <a href={WHATSAPP} target="_blank" rel="noopener" class="header-phone"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
        <a href="#contacto" class="btn btn-yellow">Cotizar gratis</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="vtag"><i class="ti ti-map-pin"></i> La Serena y Región de Coquimbo</span>
        <h1>{H1}</h1>
        <p class="lead">
          Chat con IA para la página web de tu negocio en La Serena o Coquimbo: atiende a
          tus clientes las 24 horas, responde sus preguntas y te deja sus datos listos para
          cerrar la venta, incluso en plena temporada alta o fuera de horario.
        </p>
        <div class="hero-buttons">
          <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
          <a href="#planes" class="btn btn-white btn-lg">Ver planes</a>
        </div>
        <ul class="hero-facts">
          <li>Listo en 24 horas</li>
          <li>Desde $12.000 al mes</li>
          <li>Sin permanencia</li>
        </ul>
      </div>

      <div class="chat-preview" aria-label="Ejemplo de conversación con un chatbot con IA para un negocio de turismo en La Serena">
        <div class="chat-preview-head">
          <img src={`${IMG}/brand/chatia-avatar.webp`} alt="" width="40" height="40" />
          <div>
            <strong>Asistente Cabañas Elqui</strong>
            <span><span class="dot"></span> Responde al instante</span>
          </div>
        </div>
        <div class="chat-preview-body">
          <div class="cp-msg cp-user">Hola, ¿tienen cabañas para 4 personas la primera semana de febrero?</div>
          <div class="cp-msg cp-bot">¡Hola! Tenemos cabañas para 4 personas, con tinaja y estacionamiento. En febrero los valores son por noche; ¿me dejas tu nombre y teléfono para confirmarte disponibilidad?</div>
          <div class="cp-msg cp-user">Sí, soy Rodrigo, 9 8765 4321</div>
          <div class="cp-msg cp-bot">Gracias, Rodrigo 😊 Le aviso al equipo y te contactan hoy para confirmar fechas y valor.</div>
        </div>
        <p class="cp-note">Ejemplo de un chatbot con IA para un negocio de turismo</p>
      </div>
    </div>
  </section>

  <nav class="subnav" aria-label="Secciones">
    <div class="container">
      <ul>
        <li><a href="#que-es">Qué es</a></li>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#rubros">Rubros</a></li>
        <li><a href="#planes">Planes</a></li>
        <li><a href="#pagina-web">Página web</a></li>
        <li><a href="#faq">Preguntas frecuentes</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </div>
  </nav>

  <!-- Qué es -->
  <section id="que-es" class="band">
    <div class="container about-grid">
      <div>
        <h2>¿Qué es un chat con IA para negocios de La Serena?</h2>
        <p class="intro">
          Es un asistente con inteligencia artificial en la página web de tu negocio. Conversa
          con quienes te visitan, responde lo básico (servicios, precios, horarios, cómo llegar)
          y toma sus datos, de día, de noche o un domingo de verano, cuando tú o tu equipo no
          pueden contestar.
        </p>
        <ul class="feature-list">
          <li>
            <span class="ico"><i class="ti ti-bolt"></i></span>
            <div><strong>Responde al instante</strong><span>Con la información real de tu negocio: servicios, tarifas, horarios, ubicación y preguntas frecuentes.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-moon"></i></span>
            <div><strong>Atiende fuera de horario</strong><span>Muchos turistas y clientes consultan de noche o en fin de semana. El chatbot responde cuando tú no puedes.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-user-plus"></i></span>
            <div><strong>Te consigue contactos</strong><span>Nombre, teléfono y lo que necesita el cliente llegan a tu correo con la conversación completa.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-shield-check"></i></span>
            <div><strong>No inventa información</strong><span>Si no sabe algo, lo dice y deja el contacto para que tu negocio responda.</span></div>
          </li>
        </ul>
      </div>
      <div>
      <figure class="photo"><img src={`${IMG}/ciudades/la-serena-faro.webp`} alt="Faro Monumental de La Serena junto a la playa" width="1500" height="1000" loading="lazy" /></figure>
      <div class="quote-box">
        <h3>La consulta que no se responde, se va con la competencia</h3>
        <p>Quien busca un servicio en La Serena suele escribirle a varios negocios y se queda con el primero que responde. Si estás atendiendo, en terreno o fuera de horario, esa consulta se enfría.</p>
        <p class="mb-0">Con un chatbot con IA, tu página atiende en el momento y deja la consulta registrada para que la retomes cuando puedas.</p>
      </div>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section id="como-funciona" class="band band-dark">
    <div class="container">
      <div class="band-head">
        <h2>Cómo funciona</h2>
        <p>Tres pasos, sin que tengas que programar nada y sin salir de tu negocio.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-num">1</span>
          <h3>Nos cuentas tu negocio</h3>
          <p>Servicios, precios, horarios, ubicación y las preguntas que más te hacen. Tú decides qué se informa y qué no.</p>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <h3>Entrenamos tu chatbot</h3>
          <p>La IA aprende solo de tu información y queda lista para atender como lo haría tu mejor vendedor.</p>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <h3>Queda instalado en tu web</h3>
          <p>En 24 horas atiende a tus visitantes y te avisa por correo cuando alguien deja sus datos.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Rubros -->
  <section id="rubros" class="band band-yellow">
    <div class="container">
      <div class="band-head">
        <h2>Chatbot con IA para los negocios de La Serena y Coquimbo</h2>
        <p>Lo configuramos con tu rubro y las preguntas reales que recibes de tus clientes.</p>
      </div>
      <div class="rubros rubros-3">
        {rubros.map((r) => (
          <div class="rubro">
            <div class="bubble">{r.q}</div>
            <h3 class="rubro-name"><i class={`ti ${r.icon}`}></i> {r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
      <p class="plans-note" style="margin-top:24px">
        También tenemos páginas especializadas para
        {landings.map((l, i) => (
          <>{i > 0 ? (i === landings.length - 1 ? " y " : ", ") : " "}<a href={l.href}>{l.short}</a></>
        ))}.
      </p>
    </div>
  </section>

  <!-- Atención 100% online -->
  <section id="online" class="band">
    <div class="container about-grid">
      <div>
        <h2>Atención 100% online para toda la Región de Coquimbo</h2>
        <p class="intro">
          Chatia no necesita que nos visites ni que viajes: todo el proceso se coordina por
          WhatsApp y correo, y tu chatbot queda funcionando en tu página web en 24 horas.
        </p>
        <ul class="feature-list">
          <li>
            <span class="ico"><i class="ti ti-brand-whatsapp"></i></span>
            <div><strong>Coordinación directa</strong><span>Hablas con una persona por WhatsApp, no con un formulario sin respuesta.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-map-2"></i></span>
            <div><strong>La Serena, Coquimbo y alrededores</strong><span>Negocios de La Serena, Coquimbo, Ovalle, Vicuña, Paihuano y el resto de la región.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-adjustments"></i></span>
            <div><strong>Tú controlas qué informa</strong><span>Tarifas, horarios de temporada, promociones: el bot usa únicamente lo que tú autorizas.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-calendar-off"></i></span>
            <div><strong>Sin permanencia forzosa</strong><span>Plan mensual, útil también para negocios de temporada.</span></div>
          </li>
        </ul>
      </div>
      <div>
      <div class="quote-box">
        <h3>Pruébalo como lo haría un cliente</h3>
        <p>Abre el chat de esta página y escríbele como lo haría tu cliente: una consulta de precios, de horarios o de reserva. Puedes pedirle que actúe como asistente de un negocio de La Serena.</p>
        <p class="mb-0"><button type="button" class="btn btn-dark" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button></p>
      </div>
      </div>
    </div>
  </section>

  <!-- Planes -->
  <section id="planes" class="band band-soft">
    <div class="container">
      <div class="band-head">
        <h2>Planes y precios</h2>
        <p>Chatbot con IA para tu negocio en La Serena, con precios fijos y claros.</p>
      </div>
      <div class="plans">
        <div class="plan">
          <h3>Pymes</h3>
          <p class="price">$12.000 <span>CLP al mes</span></p>
          <ul>
            <li><i class="ti ti-check"></i> <span><strong>1.000 respuestas al mes</strong> (aprox. 250 conversaciones)</span></li>
            <li><i class="ti ti-check"></i> 1 chatbot instalado en tu página web</li>
            <li><i class="ti ti-check"></i> Entrenado con la información de tu negocio</li>
            <li><i class="ti ti-check"></i> Historial de conversaciones</li>
            <li><i class="ti ti-check"></i> Aviso por correo de cada contacto</li>
            <li><i class="ti ti-check"></i> Actualización de la información 1 vez al mes</li>
          </ul>
          <a href="#contacto" class="btn btn-white btn-block" data-plan="Plan Pymes - $12.000 CLP/mes">Cotizar plan Pymes</a>
        </div>
        <div class="plan featured">
          <span class="plan-tag">Más elegido</span>
          <h3>Empresas</h3>
          <p class="price">$16.000 <span>CLP al mes</span></p>
          <ul>
            <li><i class="ti ti-check"></i> <span><strong>2.000 respuestas al mes</strong> (aprox. 500 conversaciones)</span></li>
            <li><i class="ti ti-check"></i> Hasta 2 chatbots (otro sitio o sucursal)</li>
            <li><i class="ti ti-check"></i> Entrenado con la información de tu negocio</li>
            <li><i class="ti ti-check"></i> Historial de conversaciones</li>
            <li><i class="ti ti-check"></i> Aviso por correo de cada contacto</li>
            <li><i class="ti ti-check"></i> Actualizaciones de información ilimitadas</li>
          </ul>
          <a href="#contacto" class="btn btn-dark btn-block" data-plan="Plan Empresas - $16.000 CLP/mes">Cotizar plan Empresas</a>
        </div>
      </div>
      <p class="plans-note">Instalación: pago único de $4.000 CLP. Mensualidad por transferencia bancaria, con boleta de honorarios. Sin permanencia forzosa.</p>
    </div>
  </section>

  <!-- Diseño o rediseño web -->
  <WebOffer
    title="¿Tu negocio aún no tiene página web, o la actual quedó antigua?"
    intro="El chatbot necesita una página donde vivir. DiseñoPáginas.cl puede crear la página web de tu negocio en La Serena o rediseñar la que tienes, y dejarla con el chatbot ya instalado."
    items={[
      { icon: "ti-world", title: "Te encuentran en Google", text: "Quien busca tu servicio en La Serena o Coquimbo puede llegar a tu sitio, no solo a un directorio o una red social." },
      { icon: "ti-device-mobile", title: "Se ve bien en el celular", text: "La mayoría de las consultas llegan desde el teléfono; la página sale pensada para eso." },
      { icon: "ti-message-circle", title: "Con el chatbot incluido", text: "La página sale lista para atender consultas 24/7 desde el primer día." },
    ]}
    quoteTitle="Primero el chatbot, y la página si la necesitas"
    quoteParagraphs={[
      "Si ya tienes página web, instalamos el chatbot en ella y listo. Si no la tienes, o se ve antigua o no funciona bien en celulares, la creamos o la rediseñamos y la dejamos con el chatbot funcionando.",
      "La página web se cotiza aparte, según lo que necesite tu negocio.",
    ]}
    href={DISENO_WEB}
    image={{ src: `${IMG}/heroes/chatbot-whatsapp-ia-hero-v3.webp`, alt: "Página web con chatbot de inteligencia artificial en un celular" }}
  />

  <!-- FAQ -->
  <section id="faq" class="band">
    <div class="container">
      <div class="band-head">
        <h2>Preguntas frecuentes</h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <div class={`faq-item${i === 0 ? " open" : ""}`}>
            <button class="faq-q" type="button" aria-expanded={i === 0 ? "true" : "false"}>
              {f.q}
              <i class="ti ti-chevron-down chev"></i>
            </button>
            <div class="faq-a"><div class="faq-a-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="band band-soft">
    <div class="container contact-grid">
      <div>
        <h2>Cotiza tu chatbot con IA en La Serena</h2>
        <p class="intro" style="font-size:1.15rem;color:#4a4f56">Cuéntanos de tu negocio y te enviamos una propuesta sin compromiso.</p>
        <div class="contact-direct">
          <a href={WHATSAPP} target="_blank" rel="noopener"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
          <a href={`mailto:${EMAIL}`}><i class="ti ti-mail"></i> {EMAIL}</a>
          <a href={FACEBOOK} target="_blank" rel="noopener"><i class="ti ti-brand-facebook"></i> facebook.com/chatbotia.cl</a>
        </div>
      </div>
      <div class="contact-form">
        <h3 class="contact-form-title">Formulario de contacto</h3>
        <form class="form-grid" id="contactForm">
          <input type="text" name="nombre" placeholder="Nombre" aria-label="Nombre" required />
          <input type="tel" name="fono" placeholder="Teléfono" aria-label="Teléfono" required />
          <input type="email" name="email" placeholder="Email" aria-label="Email" required />
          <select name="plan" id="planSelect" aria-label="Plan de interés" required>
            <option value="">¿Qué plan te interesa?</option>
            <option value="Plan Pymes - $12.000 CLP/mes">Plan Pymes ($12.000 al mes)</option>
            <option value="Plan Empresas - $16.000 CLP/mes">Plan Empresas ($16.000 al mes)</option>
            <option value="Chatbot + página web nueva o rediseño">Chatbot y página web (nueva o rediseño)</option>
            <option value="No estoy seguro, quiero asesoría">No estoy seguro, quiero asesoría</option>
          </select>
          <input class="full" type="text" name="web" placeholder="Página web de tu negocio (si tienes)" aria-label="Página web" />
          <textarea class="full" name="mensaje" placeholder="¿A qué se dedica tu negocio?" aria-label="Mensaje" rows="4" required></textarea>
          <button type="submit" class="btn btn-dark btn-block full"><i class="ti ti-brand-whatsapp"></i> Enviar por WhatsApp</button>
        </form>
        <p class="form-note">Al enviar se abrirá WhatsApp con tu mensaje listo.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="band cta">
    <div class="container cta-inner">
      <h2>Que ninguna consulta se quede sin respuesta esta temporada</h2>
      <div class="cta-buttons">
        <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
        <a href={WHATSAPP} target="_blank" rel="noopener" class="btn btn-white btn-lg"><i class="ti ti-brand-whatsapp"></i> Escríbenos</a>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div>
          <img class="footer-logo" src={`${IMG}/brand/chatia-logo-h-white.webp`} alt="Chatia" width="565" height="120" loading="lazy" />
          <p style="max-width:420px">Chatia instala chatbots con inteligencia artificial en páginas web de pymes y empresas de La Serena y todo Chile, para que ningún cliente se quede sin respuesta.</p>
        </div>
        <div>
          <h3>Chatbot por rubro</h3>
          <ul class="footer-links">
            {landings.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
            <li><a href="/#rubros">Ver todos los rubros</a></li>
          </ul>
        </div>
        <div>
          <h3>Chatbot por ciudad</h3>
          <ul class="footer-links">
            {ciudades.map((c) => (
              <li><a href={c.href}>{c.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Contacto</h3>
          <div class="footer-contact">
            <p><i class="ti ti-brand-whatsapp"></i> <a href={WHATSAPP} target="_blank" rel="noopener">{PHONE_DISPLAY}</a></p>
            <p><i class="ti ti-mail"></i> <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
            <p><i class="ti ti-brand-facebook"></i> <a href={FACEBOOK} target="_blank" rel="noopener">Síguenos en Facebook</a></p>
            <p><i class="ti ti-map-pin"></i> Atendemos La Serena y todo Chile</p>
            <p><i class="ti ti-clock"></i> Lunes a sábado</p>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="mb-0">&copy; {new Date().getFullYear()} Chatia, chatbot con IA en Chile</p>
        <p class="mb-0">Un servicio de <a href="https://diseñopaginas.cl" target="_blank" rel="noopener">DiseñoPáginas.cl</a></p>
      </div>
    </div>
  </footer>

  <DemoChatWidget
    vertical="laserena"
    botStatus="Asistente IA · La Serena"
    welcomeMessage="¡Hola! 👋 Soy Chatia, un chatbot con IA. Así atendería a los clientes de tu negocio en La Serena, 24/7. Pídeme que actúe como asistente de tu rubro, o pregúntame por el servicio."
    quickReplies={[
      { label: "Actúa como asistente de unas cabañas", reply: "" },
      { label: "Soy de La Serena, ¿cómo parto?", reply: "" },
      { label: "¿Cuánto cuesta?", reply: "" },
      { label: "¿Tienen oficina en La Serena?", reply: "" },
    ]}
    disclaimer="Esta es una demo real con IA. Tu chatbot se entrena con la información de tu negocio."
  />

  <script>
    document.querySelectorAll('.faq-item').forEach((item) => {
      const btn = item.querySelector('.faq-q');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach((el) => {
          el.classList.remove('open');
          el.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.querySelectorAll('[data-open-chat]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const root = document.getElementById('demoChat');
        const bubble = document.getElementById('demoChatBubble');
        if (root && bubble && !root.classList.contains('is-open')) bubble.click();
      });
    });

    const planSelect = document.getElementById('planSelect') as HTMLSelectElement | null;
    document.querySelectorAll('[data-plan]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (planSelect) planSelect.value = (btn as HTMLElement).dataset.plan || '';
      });
    });

    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const web = String(data.get('web') || '').trim();
      const text =
        `Hola, los contacto desde chatbotia.cl/la-serena.\n` +
        `Nombre: ${data.get('nombre')}\nTeléfono: ${data.get('fono')}\nEmail: ${data.get('email')}\n` +
        `Plan: ${data.get('plan')}\n` +
        (web ? `Web: ${web}\n` : '') +
        `Negocio: ${data.get('mensaje')}`;
      window.open(`https://api.whatsapp.com/send?phone=56961765268&text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</body>
</html>
