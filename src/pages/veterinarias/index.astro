---
import '../../styles/global.css';
import '../../styles/vertical.css';
import DemoChatWidget from '../../components/DemoChatWidget.astro';
import { landings, ciudades } from '../../data/landings';
import WebOffer from '../../components/WebOffer.astro';

const SITE = "https://chatbotia.cl";
const URL = `${SITE}/veterinarias/`;
const WA_NUMBER = "56961765268";
const WHATSAPP = `https://api.whatsapp.com/send?phone=${WA_NUMBER}&text=${encodeURIComponent("Hola, los contacto desde chatbotia.cl/veterinarias. Me interesa un chatbot con IA para mi veterinaria.")}`;
const PHONE_DISPLAY = "+56 9 6176 5268";
const EMAIL = "codigoraul@gmail.com";
const FACEBOOK = "https://www.facebook.com/chatbotia.cl";
const DISENO_WEB = "https://diseñopaginas.cl";

const H1 = "Chatbot con IA para veterinarias";
const TITLE = "Chatbot con IA para Veterinarias y Clínicas de Mascotas | Chatia";
const DESCRIPTION = "Chat con IA para veterinarias: responde por vacunas, horarios y urgencias las 24 horas, pide los datos de la mascota y te deja la solicitud lista para confirmar. Desde $12.000 al mes.";
const OG_IMAGE = `${SITE}/assets/img/brand/og-chatia.jpg`;
const IMG = "/assets/img";

const items = [
  {
    "icon": "ti-stethoscope",
    "title": "Consultas y controles",
    "text": "Consulta general, controles de cachorros y seguimiento de pacientes crónicos.",
    "q": "¿Atienden conejos y otras mascotas exóticas?"
  },
  {
    "icon": "ti-vaccine-bottle",
    "title": "Vacunas y desparasitación",
    "text": "Calendarios de vacunación, antiparasitarios y qué llevar el día de la visita.",
    "q": "¿Cuándo toca la segunda vacuna de mi cachorro?"
  },
  {
    "icon": "ti-scissors",
    "title": "Esterilización y cirugías",
    "text": "Cómo se prepara el animal, ayuno previo y cuidados posteriores que tú definas.",
    "q": "¿Cuánto demora la esterilización de una perra?"
  },
  {
    "icon": "ti-ambulance",
    "title": "Urgencias",
    "text": "Horarios de urgencia, teléfono directo y qué hacer mientras se llega a la clínica.",
    "q": "Mi perro comió chocolate, ¿qué hago?"
  },
  {
    "icon": "ti-bath",
    "title": "Peluquería y baño",
    "text": "Servicios de grooming, duración y reservas por tamaño del animal.",
    "q": "¿Hacen baño y corte para razas grandes?"
  },
  {
    "icon": "ti-shopping-cart",
    "title": "Tienda y farmacia veterinaria",
    "text": "Alimentos, accesorios y productos disponibles, con retiro o despacho si lo ofreces.",
    "q": "¿Tienen alimento para gatos esterilizados?"
  }
];

const faqs = [
  {
    "q": "¿Para qué sirve un chatbot en una veterinaria?",
    "a": "Para responder al instante lo habitual (horarios, servicios, vacunas, valores referenciales), tomar los datos de la mascota y del dueño y avisarte por correo. También ayuda a que una urgencia se derive a una llamada y no se pierda en un formulario."
  },
  {
    "q": "¿Qué pasa si alguien escribe por una emergencia?",
    "a": "Si el mensaje indica intoxicación, atropello, convulsiones, sangrado o dificultad para respirar, el chatbot pide llamar de inmediato al teléfono de urgencias que tú definas. No intenta resolver el caso por chat."
  },
  {
    "q": "¿Puede recetar o recomendar medicamentos?",
    "a": "No. No indica medicamentos, dosis ni remedios caseros. Puede dar información general que tú autorices y siempre invita a una consulta con el médico veterinario."
  },
  {
    "q": "¿Se integra con mi agenda o ficha clínica?",
    "a": "No se conecta a sistemas de fichas ni de agenda. Recoge los datos de la solicitud y te envía la conversación completa por correo para que recepción confirme."
  },
  {
    "q": "¿Puede informar precios y promociones?",
    "a": "Sí, si tú lo autorizas: valores referenciales de vacunas, controles o peluquería, o campañas de esterilización. Si prefieres no publicar montos, invita a consultar con recepción."
  },
  {
    "q": "¿Cuánto cuesta el servicio?",
    "a": "Hay dos planes mensuales: $12.000 CLP (1.000 respuestas, un chatbot) y $16.000 CLP (2.000 respuestas, hasta dos chatbots). La instalación es un pago único de $4.000 CLP. Se paga por transferencia, con boleta de honorarios, sin permanencia."
  },
  {
    "q": "¿Cuánto tarda en quedar listo?",
    "a": "Desde que nos entregas los datos de tu clínica, el chatbot queda funcionando en 24 horas."
  },
  {
    "q": "¿Y si mi veterinaria solo tiene Instagram o Facebook?",
    "a": "Podemos crear tu sitio web desde DiseñoPáginas.cl y entregarlo con el chatbot instalado. La página se cotiza aparte; el asistente funciona en cualquier sitio que permita agregar un código."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Chatbot con IA para veterinarias y clínicas de mascotas",
    "serviceType": "Chatbot con inteligencia artificial para sitios web de veterinarias",
    "provider": {
      "@type": "Organization",
      "name": "Chatia",
      "url": SITE,
      "logo": `${SITE}/assets/img/brand/chatia-icon-512.png`,
      "email": EMAIL,
      "telephone": "+56961765268",
      "sameAs": [FACEBOOK],
    },
    "areaServed": {
        "@type": "Country",
        "name": "Chile"
    },
    "offers": [
        {
            "@type": "Offer",
            "name": "Plan Pymes",
            "price": "12000",
            "priceCurrency": "CLP"
        },
        {
            "@type": "Offer",
            "name": "Plan Empresas",
            "price": "16000",
            "priceCurrency": "CLP"
        }
    ]
},
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Chatia", "item": `${SITE}/` },
      { "@type": "ListItem", "position": 2, "name": "Chatbot con IA para veterinarias", "item": URL },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  },
];
---

<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{TITLE}</title>
  <meta name="description" content={DESCRIPTION} />
  <link rel="canonical" href={URL} />
  <meta name="theme-color" content="#F5C842" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={URL} />
  <meta property="og:title" content={TITLE} />
  <meta property="og:description" content={DESCRIPTION} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:site_name" content="Chatia" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/dist/tabler-icons.min.css" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body class="vertical v-vet">
  <div class="topbar">
    <div class="container">
      <a href={WHATSAPP} target="_blank" rel="noopener"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
      <a href={`mailto:${EMAIL}`}><i class="ti ti-mail"></i> {EMAIL}</a>
      <span><i class="ti ti-map-pin"></i> Atendemos todo Chile</span>
      <a href={FACEBOOK} target="_blank" rel="noopener" class="topbar-social" aria-label="Chatbotia en Facebook"><i class="ti ti-brand-facebook"></i> Facebook</a>
    </div>
  </div>

  <header class="header-main">
    <div class="container">
      <a href="/" class="brand" aria-label="Chatia, inicio">
        <img src={`${IMG}/brand/chatia-logo-h.webp`} alt="Chatia – Chatbot con IA" width="565" height="120" loading="eager" />
      </a>
      <div class="header-cta">
        <a href={WHATSAPP} target="_blank" rel="noopener" class="header-phone"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
        <a href="#contacto" class="btn btn-yellow">Cotizar gratis</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero hero-photo" style={`--bg:url('${IMG}/veterinarias/veterinarias-examen.webp')`}>
    <div class="container hero-grid">
      <div>
        <span class="vtag"><i class="ti ti-paw"></i> Para veterinarias y clínicas de mascotas</span>
        <h1>{H1}</h1>
        <p class="lead">
          Cuando una mascota se ve mal o toca la vacuna, la gente escribe de inmediato. Un asistente con IA responde en tu sitio a cualquier hora, pide los datos del animal y distingue una consulta de rutina de una urgencia.
        </p>
        <div class="hero-buttons">
          <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
          <a href="#planes" class="btn btn-white btn-lg">Ver planes</a>
        </div>
        <ul class="hero-facts">
          <li>Listo en 24 horas</li>
          <li>Desde $12.000 al mes</li>
          <li>Plan mensual sin permanencia</li>
        </ul>
      </div>

      <div class="chat-preview" aria-label="Ejemplo de conversación con un chatbot con IA para una clínica veterinaria">
        <div class="chat-preview-head">
          <img src={`${IMG}/brand/chatia-avatar.webp`} alt="" width="40" height="40" />
          <div>
            <strong>Asistente Clínica Veterinaria</strong>
            <span><span class="dot"></span> Responde al instante</span>
          </div>
        </div>
        <div class="chat-preview-body">
          <div class="cp-msg cp-user">Hola, mi gatito de 2 meses necesita sus primeras vacunas. ¿Qué día pueden?</div>
          <div class="cp-msg cp-bot">¡Hola! La clínica atiende vacunas para gatitos. Para reservar, ¿me indicas tu nombre, un teléfono y cómo se llama tu gatito?</div>
          <div class="cp-msg cp-user">Soy Carolina, 9 7788 1122. Se llama Mochi.</div>
          <div class="cp-msg cp-bot">Gracias, Carolina. Dejé la solicitud de vacunas para Mochi y recepción te confirma el día disponible. Si ves vómitos seguidos o decaimiento, llámanos ahora a la clínica.</div>
        </div>
        <p class="cp-note">Ejemplo de un chatbot con IA para una clínica veterinaria</p>
      </div>
    </div>
  </section>

  <nav class="subnav" aria-label="Secciones">
    <div class="container">
      <ul>
        <li><a href="#que-es">Qué es</a></li>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#atencion">Qué atiende</a></li>
        <li><a href="#urgencias">Urgencias</a></li>
        <li><a href="#planes">Planes</a></li>
        <li><a href="#pagina-web">Página web</a></li>
        <li><a href="#faq">Preguntas frecuentes</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </div>
  </nav>

  <!-- Qué es -->
  <section id="que-es" class="band">
    <div class="container about-grid">
      <div>
        <h2>¿Qué hace un chatbot con IA en una veterinaria?</h2>
        <p class="intro">
          Atiende el chat de tu sitio como tu mejor recepcionista de guardia: responde horarios, servicios y valores referenciales, pregunta por la especie, la edad y el motivo, y te deja la solicitud ordenada. Funciona cuando estás en pabellón, en una cirugía o ya cerraste.
        </p>
        <ul class="feature-list">
          <li>
            <span class="ico"><i class="ti ti-clock-24"></i></span>
            <div><strong>Responde a toda hora</strong><span>Horarios, servicios, ubicación y medios de pago, con la información real de tu clínica.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-vaccine"></i></span>
            <div><strong>Ordena las solicitudes</strong><span>Pide especie, edad, nombre de la mascota y motivo, y te lo envía por correo.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-ambulance"></i></span>
            <div><strong>Reconoce señales de urgencia</strong><span>Ante envenenamiento, atropello, convulsiones o dificultad para respirar, pide llamar de inmediato a la clínica.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-prescription"></i></span>
            <div><strong>No diagnostica ni receta</strong><span>No indica medicamentos ni dosis; orienta a una consulta con el médico veterinario.</span></div>
          </li>
        </ul>
      </div>
      <div>
      <figure class="photo"><img src={`${IMG}/veterinarias/veterinarias-mascota.webp`} alt="Veterinaria sonriente con una pequeña paciente y su perro de raza yorkshire" width="1500" height="1000" loading="lazy" /></figure>
      <div class="quote-box">
        <h3>Un dueño preocupado no espera al día siguiente</h3>
        <p>Cuando una mascota está mal, quien la cuida escribe a varias clínicas y se queda con la que contesta primero. Si tu página no responde, esa consulta se va.</p>
        <p class="mb-0">Con el chatbot, la persona recibe una respuesta al instante y sabe qué hacer, mientras tú retomas la solicitud con todos los datos del animal.</p>
      </div>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section id="como-funciona" class="band band-dark">
    <div class="container">
      <div class="band-head">
        <h2>Cómo se instala</h2>
        <p>Tres pasos simples, sin parar la agenda de pacientes.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-num">1</span>
          <h3>Nos cuentas cómo atiendes</h3>
          <p>Servicios, horarios regulares y de urgencia, tipos de animales que atiendes y las preguntas frecuentes.</p>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <h3>Definimos qué es urgente</h3>
          <p>Fijamos las señales de alarma y el teléfono al que se deriva cuando una mascota no puede esperar.</p>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <h3>Queda activo en tu sitio</h3>
          <p>En 24 horas atiende a quienes visitan tu página y te avisa por correo de cada solicitud.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Qué atiende -->
  <section id="atencion" class="band band-yellow">
    <div class="container">
      <div class="band-head">
        <h2>Un chatbot que conoce los servicios de tu clínica</h2>
        <p>Se configura con tu lista de servicios y las dudas que de verdad llegan a tu recepción.</p>
      </div>
      <div class="rubros rubros-3">
        {items.map((r) => (
          <div class="rubro">
            <div class="bubble">{r.q}</div>
            <h3 class="rubro-name"><i class={`ti ${r.icon}`}></i> {r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Urgencias -->
  <section id="urgencias" class="band">
    <div class="container about-grid">
      <div>
        <h2>Qué hace el chatbot cuando una mascota está mal</h2>
        <p class="intro">
          Las consultas veterinarias no tienen la misma urgencia. El asistente aprende a distinguirlas para que una emergencia no quede esperando en una bandeja de correo.
        </p>
        <ul class="feature-list">
          <li>
            <span class="ico"><i class="ti ti-alert-octagon"></i></span>
            <div><strong>Señales de alarma</strong><span>Intoxicación, golpes, sangrado, convulsiones o mucha dificultad para respirar activan la derivación inmediata.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-phone-call"></i></span>
            <div><strong>Un teléfono, no un formulario</strong><span>En urgencias entrega el número que tú definas y pide llamar ahora.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-notes-off"></i></span>
            <div><strong>Sin diagnóstico ni dosis</strong><span>No sugiere medicamentos ni remedios caseros; el médico veterinario evalúa al animal.</span></div>
          </li>
          <li>
            <span class="ico"><i class="ti ti-id"></i></span>
            <div><strong>Datos de la mascota</strong><span>Especie, edad, nombre y motivo de consulta, para que el equipo se prepare antes de llamar.</span></div>
          </li>
        </ul>
      </div>
      <div>
      <div class="quote-box">
        <h3>Pruébalo como lo haría un dueño</h3>
        <p>Abre el chat de esta página y escribe como alguien que pide vacunas para su cachorro o que está preocupado por su gato. También puedes pedirle que actúe como asistente de una veterinaria.</p>
        <p class="mb-0"><button type="button" class="btn btn-dark" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button></p>
      </div>
      </div>
    </div>
  </section>

  <!-- Planes -->
  <section id="planes" class="band band-soft">
    <div class="container">
      <div class="band-head">
        <h2>Planes y precios</h2>
        <p>Chatbot con IA para tu veterinaria, con precios fijos y claros.</p>
      </div>
      <div class="plans">
        <div class="plan">
          <h3>Veterinarias pequeñas</h3>
          <p class="price">$12.000 <span>CLP al mes</span></p>
          <ul>
            <li><i class="ti ti-check"></i> <span><strong>1.000 respuestas al mes</strong> (aprox. 250 conversaciones)</span></li>
            <li><i class="ti ti-check"></i> 1 chatbot instalado en tu página web</li>
            <li><i class="ti ti-check"></i> Entrenado con los servicios y horarios de tu clínica</li>
            <li><i class="ti ti-check"></i> Historial de conversaciones</li>
            <li><i class="ti ti-check"></i> Aviso por correo de cada solicitud o consulta</li>
            <li><i class="ti ti-check"></i> Actualización de la información 1 vez al mes</li>
          </ul>
          <a href="#contacto" class="btn btn-white btn-block" data-plan="Plan Pymes - $12.000 CLP/mes">Cotizar plan Pymes</a>
        </div>
        <div class="plan featured">
          <span class="plan-tag">Más elegido</span>
          <h3>Clínicas con más pacientes</h3>
          <p class="price">$16.000 <span>CLP al mes</span></p>
          <ul>
            <li><i class="ti ti-check"></i> <span><strong>2.000 respuestas al mes</strong> (aprox. 500 conversaciones)</span></li>
            <li><i class="ti ti-check"></i> Hasta 2 chatbots (otra sucursal u otro sitio)</li>
            <li><i class="ti ti-check"></i> Entrenado con los servicios y horarios de tu clínica</li>
            <li><i class="ti ti-check"></i> Historial de conversaciones</li>
            <li><i class="ti ti-check"></i> Aviso por correo de cada solicitud o consulta</li>
            <li><i class="ti ti-check"></i> Actualizaciones de información ilimitadas</li>
          </ul>
          <a href="#contacto" class="btn btn-dark btn-block" data-plan="Plan Empresas - $16.000 CLP/mes">Cotizar plan Empresas</a>
        </div>
      </div>
      <p class="plans-note">Instalación: pago único de $4.000 CLP. Mensualidad por transferencia bancaria, con boleta de honorarios. Sin permanencia forzosa.</p>
    </div>
  </section>

  <!-- Diseño o rediseño web (oferta secundaria) -->
  <WebOffer
    title={"¿Tu veterinaria todavía no tiene sitio web, o quedó desactualizado?"}
    intro={"El chatbot necesita una página donde atender. DiseñoPáginas.cl puede crear el sitio de tu clínica o rediseñar el que tienes, mostrando tus servicios y tu equipo, y dejarlo con el asistente listo."}
    items={[
    {
        "icon": "ti-map-2",
        "title": "Te encuentran cerca de casa",
        "text": "Quien busca una veterinaria en su sector llega a tu sitio con tus horarios, mapa y teléfono."
    },
    {
        "icon": "ti-heart",
        "title": "Muestra cómo cuidas",
        "text": "Tu equipo, tus instalaciones y los servicios que ofreces, con un diseño amable y claro."
    },
    {
        "icon": "ti-message-circle",
        "title": "Con el chatbot incluido",
        "text": "La página sale lista para recibir solicitudes y urgencias desde el primer día."
    }
]}
    quoteTitle={"Primero el chatbot; el sitio, si lo necesitas"}
    quoteParagraphs={[
    "Si ya tienes una página, instalamos el chatbot ahí. Si todavía usas solo redes sociales, o la web actual no se ve bien en el celular, la creamos o rediseñamos.",
    "El sitio web se cotiza aparte, según el tamaño de tu clínica."
]}
    href={DISENO_WEB}
  />

  <!-- FAQ -->
  <section id="faq" class="band">
    <div class="container">
      <div class="band-head">
        <h2>Preguntas frecuentes</h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <div class={`faq-item${i === 0 ? " open" : ""}`}>
            <button class="faq-q" type="button" aria-expanded={i === 0 ? "true" : "false"}>
              {f.q}
              <i class="ti ti-chevron-down chev"></i>
            </button>
            <div class="faq-a"><div class="faq-a-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="band band-soft">
    <div class="container contact-grid">
      <div>
        <h2>Cotiza tu chatbot con IA para tu veterinaria</h2>
        <p class="intro" style="font-size:1.15rem;color:#4a4f56">Cuéntanos qué servicios ofreces y te enviamos una propuesta sin compromiso.</p>
        <div class="contact-direct">
          <a href={WHATSAPP} target="_blank" rel="noopener"><i class="ti ti-brand-whatsapp"></i> {PHONE_DISPLAY}</a>
          <a href={`mailto:${EMAIL}`}><i class="ti ti-mail"></i> {EMAIL}</a>
          <a href={FACEBOOK} target="_blank" rel="noopener"><i class="ti ti-brand-facebook"></i> facebook.com/chatbotia.cl</a>
        </div>
      </div>
      <div class="contact-form">
        <h3 class="contact-form-title">Formulario de contacto</h3>
        <form class="form-grid" id="contactForm">
          <input type="text" name="nombre" placeholder="Nombre" aria-label="Nombre" required />
          <input type="tel" name="fono" placeholder="Teléfono" aria-label="Teléfono" required />
          <input type="email" name="email" placeholder="Email" aria-label="Email" required />
          <select name="plan" id="planSelect" aria-label="Plan de interés" required>
            <option value="">¿Qué plan te interesa?</option>
            <option value="Plan Pymes - $12.000 CLP/mes">Plan Pymes ($12.000 al mes)</option>
            <option value="Plan Empresas - $16.000 CLP/mes">Plan Empresas ($16.000 al mes)</option>
            <option value="Chatbot + página web nueva o rediseño">Chatbot y página web (nueva o rediseño)</option>
            <option value="No estoy seguro, quiero asesoría">No estoy seguro, quiero asesoría</option>
          </select>
          <input class="full" type="text" name="web" placeholder="Sitio web de tu veterinaria (si tienes)" aria-label="Página web" />
          <textarea class="full" name="mensaje" placeholder="¿Qué servicios ofrece tu clínica?" aria-label="Mensaje" rows="4" required></textarea>
          <button type="submit" class="btn btn-dark btn-block full"><i class="ti ti-brand-whatsapp"></i> Enviar por WhatsApp</button>
        </form>
        <p class="form-note">Al enviar se abrirá WhatsApp con tu mensaje listo.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="band cta band-photo-cta" style={`--bg:url('${IMG}/veterinarias/veterinarias-examen.webp')`}>
    <div class="container cta-inner">
      <h2>Que cada dueño preocupado reciba una respuesta a tiempo</h2>
      <div class="cta-buttons">
        <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
        <a href={WHATSAPP} target="_blank" rel="noopener" class="btn btn-white btn-lg"><i class="ti ti-brand-whatsapp"></i> Escríbenos</a>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div>
          <img class="footer-logo" src={`${IMG}/brand/chatia-logo-h-white.webp`} alt="Chatia" width="565" height="120" loading="lazy" />
          <p style="max-width:420px">Chatia instala chatbots con inteligencia artificial en sitios web de veterinarias, clínicas de mascotas y pymes de todo Chile, para que ninguna consulta quede sin respuesta.</p>
        </div>
        <div>
          <h3>Chatbot por rubro</h3>
          <ul class="footer-links">
            {landings.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
            <li><a href="/#rubros">Ver todos los rubros</a></li>
          </ul>
        </div>
        <div>
          <h3>Chatbot por ciudad</h3>
          <ul class="footer-links">
            {ciudades.map((c) => (
              <li><a href={c.href}>{c.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Contacto</h3>
          <div class="footer-contact">
            <p><i class="ti ti-brand-whatsapp"></i> <a href={WHATSAPP} target="_blank" rel="noopener">{PHONE_DISPLAY}</a></p>
            <p><i class="ti ti-mail"></i> <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
            <p><i class="ti ti-brand-facebook"></i> <a href={FACEBOOK} target="_blank" rel="noopener">Síguenos en Facebook</a></p>
            <p><i class="ti ti-map-pin"></i> Atendemos todo Chile</p>
            <p><i class="ti ti-clock"></i> Lunes a sábado</p>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="mb-0">&copy; {new Date().getFullYear()} Chatia, chatbot con IA en Chile</p>
        <p class="mb-0">Clientes: <a href="https://hielosdelsur.cl" target="_blank" rel="noopener">Hielos del Sur</a></p>
        <p class="mb-0">Un servicio de <a href="https://diseñopaginas.cl" target="_blank" rel="noopener">DiseñoPáginas.cl</a></p>
        <p class="credits">Imágenes: <a href="https://www.freepik.com" target="_blank" rel="noopener">Freepik</a></p>
      </div>
    </div>
  </footer>

  <DemoChatWidget
    vertical="veterinarias"
    botStatus="Asistente IA · Veterinarias"
    welcomeMessage="Hola, soy Chatia, un chatbot con IA para veterinarias. Así atendería a los dueños de mascotas de tu clínica, a cualquier hora. Pídeme que actúe como asistente de una veterinaria, o pregúntame por el servicio."
    quickReplies={[
      { label: "Actúa como asistente de una veterinaria", reply: "" },
      { label: "Quiero vacunar a mi cachorro", reply: "" },
      { label: "Mi perro está decaído", reply: "" },
      { label: "¿Cuánto cuesta?", reply: "" },
    ]}
    disclaimer="Esta es una demo real con IA. Tu chatbot se entrena con la información de tu clínica."
  />

  <script>
    document.querySelectorAll('.faq-item').forEach((item) => {
      const btn = item.querySelector('.faq-q');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach((el) => {
          el.classList.remove('open');
          el.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.querySelectorAll('[data-open-chat]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const root = document.getElementById('demoChat');
        const bubble = document.getElementById('demoChatBubble');
        if (root && bubble && !root.classList.contains('is-open')) bubble.click();
      });
    });

    const planSelect = document.getElementById('planSelect') as HTMLSelectElement | null;
    document.querySelectorAll('[data-plan]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (planSelect) planSelect.value = (btn as HTMLElement).dataset.plan || '';
      });
    });

    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const web = String(data.get('web') || '').trim();
      const text =
        `Hola, los contacto desde chatbotia.cl/veterinarias.\n` +
        `Nombre: ${data.get('nombre')}\nTeléfono: ${data.get('fono')}\nEmail: ${data.get('email')}\n` +
        `Plan: ${data.get('plan')}\n` +
        (web ? `Web: ${web}\n` : '') +
        `Servicios de la clínica: ${data.get('mensaje')}`;
      window.open(`https://api.whatsapp.com/send?phone=56961765268&text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</body>
</html>
