        <button type="button" class="btn btn-dark btn-lg" data-open-chat><i class="ti ti-message-circle"></i> Probar la demo</button>
        <a href={WHATSAPP} target="_blank" rel="noopener" class="btn btn-white btn-lg"><i class="ti ti-brand-whatsapp"></i> Escríbenos</a>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div>
          <img class="footer-logo" src={`${IMG}/brand/chatia-logo-h-white.webp`} alt="Chatia" width="565" height="120" loading="lazy" />
          <p style="max-width:420px">Chatia instala chatbots con inteligencia artificial en sitios web de psicólogos, consultas y pymes de todo Chile, con límites claros y respeto por la privacidad.</p>
        </div>
        <div>
          <h3>Chatbot por rubro</h3>
          <ul class="footer-links">
            {landings.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
            <li><a href="/#rubros">Ver todos los rubros</a></li>
          </ul>
        </div>
        <div>
          <h3>Chatbot por ciudad</h3>
          <ul class="footer-links">
            {ciudades.map((c) => (
              <li><a href={c.href}>{c.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Contacto</h3>
          <div class="footer-contact">
            <p><i class="ti ti-brand-whatsapp"></i> <a href={WHATSAPP} target="_blank" rel="noopener">{PHONE_DISPLAY}</a></p>
            <p><i class="ti ti-mail"></i> <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
            <p><i class="ti ti-brand-facebook"></i> <a href={FACEBOOK} target="_blank" rel="noopener">Síguenos en Facebook</a></p>
            <p><i class="ti ti-map-pin"></i> Atendemos todo Chile</p>
            <p><i class="ti ti-clock"></i> Lunes a sábado</p>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="mb-0">&copy; {new Date().getFullYear()} Chatia, chatbot con IA en Chile</p>
        <p class="mb-0">Clientes: <a href="https://hielosdelsur.cl" target="_blank" rel="noopener">Hielos del Sur</a></p>
        <p class="mb-0">Un servicio de <a href="https://diseñopaginas.cl" target="_blank" rel="noopener">DiseñoPáginas.cl</a></p>
        <p class="mb-0"><a href="https://chatbotia.cl/">Chatbot con IA · chatbotia.cl</a></p>
      </div>
    </div>
  </footer>

  <DemoChatWidget
    vertical="psicologos"
    botStatus="Asistente IA · Psicología"
    welcomeMessage="Hola, soy Chatia, un chatbot con IA. Así recibiría el primer contacto de tu consulta de psicología, con calidez y sin invadir. Pídeme que actúe como asistente de una consulta, o pregúntame por el servicio."
    quickReplies={[
      { label: "Actúa como asistente de una consulta de psicología", reply: "" },
      { label: "Busco terapia online", reply: "" },
      { label: "¿El chatbot hace terapia?", reply: "" },
      { label: "¿Cuánto cuesta?", reply: "" },
    ]}
    disclaimer="Esta es una demo real con IA. Tu chatbot se entrena con la información de tu consulta."
  />

  <script>
    document.querySelectorAll('.faq-item').forEach((item) => {
      const btn = item.querySelector('.faq-q');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach((el) => {
          el.classList.remove('open');
          el.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.querySelectorAll('[data-open-chat]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const root = document.getElementById('demoChat');
        const bubble = document.getElementById('demoChatBubble');
        if (root && bubble && !root.classList.contains('is-open')) bubble.click();
      });
    });

    const planSelect = document.getElementById('planSelect') as HTMLSelectElement | null;
    document.querySelectorAll('[data-plan]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (planSelect) planSelect.value = (btn as HTMLElement).dataset.plan || '';
      });
    });

    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const web = String(data.get('web') || '').trim();
      const text =
        `Hola, los contacto desde chatbotia.cl/psicologos.\n` +
        `Nombre: ${data.get('nombre')}\nTeléfono: ${data.get('fono')}\nEmail: ${data.get('email')}\n` +
        `Plan: ${data.get('plan')}\n` +
        (web ? `Web: ${web}\n` : '') +
        `Tipo de atención: ${data.get('mensaje')}`;
      window.open(`https://api.whatsapp.com/send?phone=56961765268&text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
